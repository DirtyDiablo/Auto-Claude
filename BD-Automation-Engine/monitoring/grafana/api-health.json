{
  "dashboard": {
    "title": "PTS BD - API Health",
    "uid": "api-health",
    "tags": ["pts-bd", "api"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Request Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{"expr": "rate(pts_api_requests_total[5m])", "legendFormat": "{{endpoint}}"}]
      },
      {
        "title": "Error Rate (4xx + 5xx)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{"expr": "rate(pts_api_requests_total{status_code=~\"4..|5..\"}[5m])", "legendFormat": "{{status_code}}"}],
        "thresholds": [{"value": 0.01, "colorMode": "critical"}]
      },
      {
        "title": "Latency (p50, p95, p99)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(pts_api_request_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
          {"expr": "histogram_quantile(0.95, rate(pts_api_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
          {"expr": "histogram_quantile(0.99, rate(pts_api_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
        ]
      },
      {
        "title": "Active Requests",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{"expr": "sum(pts_api_requests_in_progress)"}]
      }
    ]
  }
}
