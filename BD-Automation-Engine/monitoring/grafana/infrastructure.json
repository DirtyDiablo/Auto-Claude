{
  "dashboard": {
    "title": "PTS BD - Infrastructure",
    "uid": "infrastructure",
    "tags": ["pts-bd", "infra"],
    "panels": [
      {
        "title": "Qdrant Query Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {"expr": "histogram_quantile(0.95, rate(pts_db_query_duration_seconds_bucket{db_type=\"qdrant\"}[5m]))", "legendFormat": "Qdrant p95"},
          {"expr": "histogram_quantile(0.95, rate(pts_db_query_duration_seconds_bucket{db_type=\"neo4j\"}[5m]))", "legendFormat": "Neo4j p95"}
        ]
      },
      {
        "title": "Database Sizes",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {"expr": "pts_qdrant_vectors_total", "legendFormat": "Qdrant Vectors"},
          {"expr": "pts_neo4j_nodes_total", "legendFormat": "Neo4j Nodes"}
        ]
      }
    ]
  }
}
