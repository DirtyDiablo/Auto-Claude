{
  "dashboard": {
    "title": "PTS BD - Search Performance",
    "uid": "search-perf",
    "tags": ["pts-bd", "search"],
    "panels": [
      {
        "title": "Search Query Volume by Type",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{"expr": "rate(pts_search_queries_total[5m])", "legendFormat": "{{type}}"}]
      },
      {
        "title": "Search Latency Distribution",
        "type": "histogram",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{"expr": "rate(pts_db_query_duration_seconds_bucket{db_type=\"qdrant\"}[5m])"}]
      },
      {
        "title": "Memory Hit Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{"expr": "rate(pts_memory_operations_total{operation=\"hit\"}[5m]) / rate(pts_memory_operations_total{operation=~\"hit|miss\"}[5m])"}]
      },
      {
        "title": "Qdrant Vector Count",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{"expr": "pts_qdrant_vectors_total"}]
      }
    ]
  }
}
