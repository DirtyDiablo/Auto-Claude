{
  "name": "Hub - Add Insight",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "add-insight",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate insight data\nconst body = $input.first().json.body;\n\nconst validTypes = ['opportunity', 'risk', 'relationship', 'strategy', 'competitive', 'market', 'technical'];\nconst insightType = body.insight_type || 'general';\n\nif (!body.insight) {\n  throw new Error('Missing required field: insight');\n}\n\nreturn {\n  json: {\n    insight_type: validTypes.includes(insightType) ? insightType : 'general',\n    insight: body.insight,\n    source: body.source || 'n8n_workflow',\n    confidence: Math.min(Math.max(body.confidence || 0.8, 0), 1),\n    metadata: body.metadata || {}\n  }\n};"
      },
      "id": "validate-insight",
      "name": "Validate Insight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/memory/insight",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "post-insight",
      "name": "Post Insight to Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format response\nconst hubResponse = $input.first().json;\nconst inputData = $('Validate Insight').first().json;\n\nreturn {\n  json: {\n    success: true,\n    message: `Added ${inputData.insight_type} insight to Hub`,\n    insight_type: inputData.insight_type,\n    confidence: inputData.confidence,\n    hub_response: hubResponse,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Insight",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Insight": {
      "main": [
        [
          {
            "node": "Post Insight to Hub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post Insight to Hub": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["hub", "insight", "memory", "production"]
}
