{
  "name": "Alert - Error Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "error-notification",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process error notification\nconst body = $input.first().json.body || {};\n\nconst error = {\n  workflow_name: body.workflow_name || 'Unknown',\n  error_message: body.error_message || body.error || 'Unknown error',\n  error_type: body.error_type || 'runtime',\n  node_name: body.node_name || 'Unknown',\n  execution_id: body.execution_id || 'N/A',\n  timestamp: new Date().toISOString(),\n  severity: 'error',\n  stack_trace: body.stack_trace || null\n};\n\n// Format for different channels\nerror.slack_message = `:rotating_light: *Workflow Error*\\n` +\n  `*Workflow:* ${error.workflow_name}\\n` +\n  `*Error:* ${error.error_message}\\n` +\n  `*Node:* ${error.node_name}\\n` +\n  `*Execution:* ${error.execution_id}\\n` +\n  `*Time:* ${error.timestamp}`;\n\nerror.hub_memory = `Workflow error in ${error.workflow_name}: ${error.error_message} (Node: ${error.node_name})`;\n\nreturn { json: error };"
      },
      "id": "process-error",
      "name": "Process Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/memory/add",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.hub_memory, memory_type: 'error_log' }) }}",
        "options": {}
      },
      "id": "log-to-hub",
      "name": "Log Error to Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://primetech.app.n8n.cloud/webhook/slack-alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Process Error').first().json.slack_message, severity: 'error', channel: '#bd-alerts' }) }}",
        "options": {}
      },
      "id": "send-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format response\nconst error = $('Process Error').first().json;\n\nreturn {\n  json: {\n    success: true,\n    message: 'Error notification processed',\n    workflow: error.workflow_name,\n    error: error.error_message,\n    logged_to_hub: true,\n    slack_notified: true,\n    timestamp: error.timestamp\n  }\n};"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Process Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Error": {
      "main": [
        [
          {
            "node": "Log Error to Hub",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error to Hub": {
      "main": [
        [
          {
            "node": "Merge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Slack": {
      "main": [
        [
          {
            "node": "Merge",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["alert", "error", "notification", "production"]
}
