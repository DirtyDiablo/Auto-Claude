{
  "name": "Monitor - Health Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8100/health",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "check-hub",
      "name": "Check Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8200/health",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "check-scraper",
      "name": "Check Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-checks",
      "name": "Merge Checks",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Evaluate overall health\nconst hubResult = $('Check Hub').first().json;\nconst scraperResult = $('Check Scraper').first().json;\n\nconst hubHealthy = hubResult.status === 'healthy';\nconst scraperHealthy = scraperResult.status === 'healthy';\n\nconst health = {\n  timestamp: new Date().toISOString(),\n  services: {\n    hub: {\n      healthy: hubHealthy,\n      status: hubResult.status || 'unreachable',\n      url: 'http://127.0.0.1:8100'\n    },\n    scraper: {\n      healthy: scraperHealthy,\n      status: scraperResult.status || 'unreachable',\n      url: 'http://127.0.0.1:8200'\n    }\n  },\n  overall_healthy: hubHealthy && scraperHealthy,\n  issues: []\n};\n\nif (!hubHealthy) health.issues.push('BD Hub is not healthy');\nif (!scraperHealthy) health.issues.push('Data Scraper is not healthy');\n\nreturn { json: health };"
      },
      "id": "evaluate-health",
      "name": "Evaluate Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.overall_healthy }}",
              "value2": false
            }
          ]
        }
      },
      "id": "has-issues",
      "name": "Has Issues?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://primetech.app.n8n.cloud/webhook/slack-alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'Health Check Alert!\\n\\nIssues detected:\\n• ' + $json.issues.join('\\n• ') + '\\n\\nTime: ' + $json.timestamp, severity: 'error', channel: '#bd-alerts' }) }}",
        "options": {}
      },
      "id": "send-alert",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "healthy"
            }
          ]
        }
      },
      "id": "log-healthy",
      "name": "Log Healthy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1250, 400]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Check Hub",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Hub": {
      "main": [
        [
          {
            "node": "Merge Checks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Scraper": {
      "main": [
        [
          {
            "node": "Merge Checks",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Checks": {
      "main": [
        [
          {
            "node": "Evaluate Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Health": {
      "main": [
        [
          {
            "node": "Has Issues?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Issues?": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["monitoring", "health", "production"]
}
