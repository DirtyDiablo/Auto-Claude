{
  "name": "Utility - Hub Integration Base",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BD_HUB_URL || 'http://127.0.0.1:8100' }}/health",
        "options": {}
      },
      "id": "hub-health",
      "name": "Hub Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BD_HUB_URL || 'http://127.0.0.1:8100' }}/ask/smart",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "={{ $json.query }}" },
            { "name": "use_cache", "value": "true" }
          ]
        },
        "options": {}
      },
      "id": "hub-smart-query",
      "name": "Hub Smart Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BD_HUB_URL || 'http://127.0.0.1:8100' }}/ingest/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.jobs) }}",
        "options": {}
      },
      "id": "hub-post-jobs",
      "name": "Hub Post Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 700]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BD_HUB_URL || 'http://127.0.0.1:8100' }}/memory/insight",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ insight_type: $json.insight_type, insight: $json.insight, source: 'n8n_workflow', confidence: $json.confidence || 0.8 }) }}"
      },
      "id": "hub-add-insight",
      "name": "Hub Add Insight",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 900]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BD_HUB_URL || 'http://127.0.0.1:8100' }}/agent/{{ $json.agent }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "={{ $json.query }}" }
          ]
        }
      },
      "id": "hub-agent-query",
      "name": "Hub Agent Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 1100]
    }
  ],
  "connections": {
    "Start": {
      "main": [[{ "node": "Hub Health Check", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["utility", "hub", "template"]
}
