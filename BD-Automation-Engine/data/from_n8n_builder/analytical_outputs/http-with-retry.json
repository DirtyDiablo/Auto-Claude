{
  "name": "Template - HTTP with Retry",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Initialize retry context\nreturn {\n  json: {\n    url: $input.first().json.url || 'http://127.0.0.1:8100/health',\n    method: $input.first().json.method || 'GET',\n    body: $input.first().json.body || null,\n    max_retries: $input.first().json.max_retries || 3,\n    retry_delay_ms: $input.first().json.retry_delay_ms || 1000,\n    current_attempt: 1,\n    errors: []\n  }\n};"
      },
      "id": "init-retry",
      "name": "Initialize Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "sendBody": "={{ $json.body !== null }}",
        "specifyBody": "json",
        "jsonBody": "={{ $json.body ? JSON.stringify($json.body) : '{}' }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-request",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Check if request succeeded\nconst response = $input.first().json;\nconst context = $('Initialize Retry').first().json;\n\nconst isSuccess = response.statusCode >= 200 && response.statusCode < 300;\n\nreturn {\n  json: {\n    ...context,\n    success: isSuccess,\n    statusCode: response.statusCode,\n    response: isSuccess ? response : null,\n    last_error: isSuccess ? null : `HTTP ${response.statusCode}`,\n    errors: isSuccess ? context.errors : [...context.errors, `Attempt ${context.current_attempt}: HTTP ${response.statusCode}`]\n  }\n};"
      },
      "id": "check-response",
      "name": "Check Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-success",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "// Return successful response\nconst result = $input.first().json;\n\nreturn {\n  json: {\n    success: true,\n    attempts: result.current_attempt,\n    statusCode: result.statusCode,\n    response: result.response,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "return-success",
      "name": "Return Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.current_attempt }}",
              "operation": "smaller",
              "value2": "={{ $json.max_retries }}"
            }
          ]
        }
      },
      "id": "if-can-retry",
      "name": "Can Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "amount": "={{ $json.retry_delay_ms * $json.current_attempt }}",
        "unit": "milliseconds"
      },
      "id": "wait",
      "name": "Wait Before Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Increment retry counter\nconst context = $input.first().json;\n\nreturn {\n  json: {\n    ...context,\n    current_attempt: context.current_attempt + 1\n  }\n};"
      },
      "id": "increment-retry",
      "name": "Increment Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Return failure after max retries\nconst result = $input.first().json;\n\nreturn {\n  json: {\n    success: false,\n    attempts: result.current_attempt,\n    max_retries: result.max_retries,\n    errors: result.errors,\n    last_error: result.last_error,\n    message: `Failed after ${result.current_attempt} attempts`,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "return-failure",
      "name": "Return Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 500]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Initialize Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Retry": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Check Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Return Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Can Retry?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Can Retry?": {
      "main": [
        [
          {
            "node": "Wait Before Retry",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait Before Retry": {
      "main": [
        [
          {
            "node": "Increment Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Increment Retry": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["template", "retry", "http", "utility"]
}
