{
  "name": "Notion - Sync to Hub",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notion-to-hub",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "returnAll": false,
        "limit": 100
      },
      "id": "get-notion-pages",
      "name": "Get Notion Pages",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [450, 300],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Transform Notion pages to Hub format\n// This would process actual Notion data when enabled\n\nconst mockData = [\n  {\n    title: 'Sample Job from Notion',\n    company: 'Sample Company',\n    location: 'Washington DC',\n    clearance: 'TS/SCI',\n    source: 'notion-sync'\n  }\n];\n\nreturn {\n  json: {\n    jobs: mockData,\n    count: mockData.length,\n    note: 'Notion node disabled - configure credentials'\n  }\n};"
      },
      "id": "transform-for-hub",
      "name": "Transform for Hub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-has-jobs",
      "name": "Has Jobs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/ingest/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.jobs) }}",
        "options": {}
      },
      "id": "post-to-hub",
      "name": "Post to Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Format response\nconst request = $('Transform for Hub').first().json;\nconst hubResponse = $input.first()?.json || {};\n\nreturn {\n  json: {\n    success: true,\n    message: `Synced ${request.count} jobs from Notion to Hub`,\n    count: request.count,\n    hub_response: hubResponse,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "format-success",
      "name": "Format Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message",
              "value": "No jobs to sync from Notion"
            }
          ],
          "boolean": [
            {
              "name": "success",
              "value": true
            }
          ],
          "number": [
            {
              "name": "count",
              "value": 0
            }
          ]
        }
      },
      "id": "no-jobs",
      "name": "No Jobs Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": []
        },
        "options": {}
      },
      "id": "merge",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Transform for Hub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform for Hub": {
      "main": [
        [
          {
            "node": "Has Jobs?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Jobs?": {
      "main": [
        [
          {
            "node": "Post to Hub",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Jobs Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Hub": {
      "main": [
        [
          {
            "node": "Format Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Success": {
      "main": [
        [
          {
            "node": "Merge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "No Jobs Response": {
      "main": [
        [
          {
            "node": "Merge",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["notion", "sync", "hub"]
}
