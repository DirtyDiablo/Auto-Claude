{
  "name": "Pipeline - Competitor Analysis",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "competitor-analysis",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Initialize competitor analysis\nconst body = $input.first().json.body || {};\n\nconst companies = body.companies || [];\nif (!Array.isArray(companies) || companies.length === 0) {\n  throw new Error('At least one company is required for analysis');\n}\n\nreturn {\n  json: {\n    companies: companies,\n    analysis_id: `comp-${Date.now()}`,\n    started_at: new Date().toISOString()\n  }\n};"
      },
      "id": "init-analysis",
      "name": "Initialize Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Split companies for parallel processing\nconst companies = $input.first().json.companies;\n\nreturn companies.map(company => ({\n  json: {\n    company: company,\n    analysis_id: $input.first().json.analysis_id\n  }\n}));"
      },
      "id": "split-companies",
      "name": "Split Companies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8100/agent/competitor",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ 'Analyze competitor: ' + $json.company }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "analyze-competitor",
      "name": "Analyze Competitor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8100/search/hybrid",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $('Split Companies').item.json.company + ' contracts awards programs' }}"
            },
            {
              "name": "collection",
              "value": "bd_knowledge"
            },
            {
              "name": "limit",
              "value": "20"
            }
          ]
        },
        "options": {}
      },
      "id": "search-intel",
      "name": "Search Intel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "// Compile individual competitor analysis\nconst company = $('Split Companies').item.json.company;\nconst analysis = $('Analyze Competitor').item.json;\nconst intel = $('Search Intel').item.json;\n\nreturn {\n  json: {\n    company: company,\n    analysis: analysis.response || analysis,\n    related_intel: (intel.results || intel.data || []).slice(0, 5),\n    intel_count: (intel.results || intel.data || []).length\n  }\n};"
      },
      "id": "compile-competitor",
      "name": "Compile Competitor Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "aggregate",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Generate final competitive analysis report\nconst allData = $input.first().json.data || $input.all().map(i => i.json);\nconst init = $('Initialize Analysis').first().json;\n\nconst report = {\n  success: true,\n  analysis_id: init.analysis_id,\n  companies_analyzed: init.companies.length,\n  competitors: allData,\n  summary: {\n    total_competitors: allData.length,\n    total_intel_found: allData.reduce((sum, c) => sum + (c.intel_count || 0), 0)\n  },\n  started_at: init.started_at,\n  completed_at: new Date().toISOString()\n};\n\nreturn { json: report };"
      },
      "id": "generate-report",
      "name": "Generate Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/memory/insight",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ insight_type: 'competitive', insight: 'Competitor analysis completed for ' + $json.companies_analyzed + ' companies. Total intelligence items found: ' + $json.summary.total_intel_found, source: 'n8n_pipeline', confidence: 0.85 }) }}",
        "options": {}
      },
      "id": "record-insight",
      "name": "Record Insight",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $('Generate Report').first().json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2050, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Initialize Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Analysis": {
      "main": [
        [
          {
            "node": "Split Companies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Companies": {
      "main": [
        [
          {
            "node": "Analyze Competitor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Competitor": {
      "main": [
        [
          {
            "node": "Search Intel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Intel": {
      "main": [
        [
          {
            "node": "Compile Competitor Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compile Competitor Data": {
      "main": [
        [
          {
            "node": "Aggregate Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Results": {
      "main": [
        [
          {
            "node": "Generate Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Report": {
      "main": [
        [
          {
            "node": "Record Insight",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Insight": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["pipeline", "competitor", "analysis", "production"]
}
