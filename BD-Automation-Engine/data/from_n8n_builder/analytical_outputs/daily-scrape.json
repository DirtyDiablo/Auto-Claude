{
  "name": "Scheduled - Daily Scrape & Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily 6 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8100/health",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "check-hub",
      "name": "Check Hub Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "healthy"
            }
          ]
        }
      },
      "id": "if-healthy",
      "name": "Hub Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8200/pipeline/full",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"sources\": [\"apex-jobs\", \"insight-global-jobs\", \"teksystems-jobs\"], \"sync_to_hub\": true}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "run-pipeline",
      "name": "Run Full Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 200]
    },
    {
      "parameters": {
        "jsCode": "// Process pipeline results\nconst results = $input.first().json;\n\nconst summary = {\n  status: results.status || 'unknown',\n  total_scraped: results.summary?.total_scraped || 0,\n  unique_jobs: results.summary?.unique || 0,\n  valid_jobs: results.summary?.valid || 0,\n  synced_to_hub: results.summary?.synced || 0,\n  duration_seconds: results.duration_seconds || 0,\n  errors: results.errors || [],\n  timestamp: new Date().toISOString()\n};\n\nreturn { json: summary };"
      },
      "id": "process-results",
      "name": "Process Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/memory/add",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'Daily scrape completed: ' + $json.synced_to_hub + ' jobs synced to Hub on ' + $json.timestamp, memory_type: 'scrape_result' }) }}",
        "options": {}
      },
      "id": "record-memory",
      "name": "Record in Hub Memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://primetech.app.n8n.cloud/webhook/slack-alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'Daily Scrape Complete!\\n\\n• Total Scraped: ' + $('Process Results').first().json.total_scraped + '\\n• Unique Jobs: ' + $('Process Results').first().json.unique_jobs + '\\n• Synced to Hub: ' + $('Process Results').first().json.synced_to_hub + '\\n• Duration: ' + $('Process Results').first().json.duration_seconds + 's', severity: 'success', channel: '#bd-updates' }) }}",
        "options": {}
      },
      "id": "notify-success",
      "name": "Notify Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://primetech.app.n8n.cloud/webhook/slack-alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'BD Hub is unavailable! Daily scrape skipped.\\nTime: ' + $now.toISO(), severity: 'error', channel: '#bd-alerts' }) }}",
        "options": {}
      },
      "id": "alert-hub-down",
      "name": "Alert Hub Down",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Daily 6 AM Trigger": {
      "main": [
        [
          {
            "node": "Check Hub Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Hub Health": {
      "main": [
        [
          {
            "node": "Hub Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hub Healthy?": {
      "main": [
        [
          {
            "node": "Run Full Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert Hub Down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Full Pipeline": {
      "main": [
        [
          {
            "node": "Process Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Results": {
      "main": [
        [
          {
            "node": "Record in Hub Memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record in Hub Memory": {
      "main": [
        [
          {
            "node": "Notify Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["scheduled", "scraper", "daily", "production"]
}
