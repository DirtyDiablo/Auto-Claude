{
  "name": "Hub - Smart Query",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hub-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8100/ask/smart",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.body.query }}"
            },
            {
              "name": "use_cache",
              "value": "={{ $json.body.use_cache !== false }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "query-hub",
      "name": "Query Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process Hub response\nconst response = $input.first().json;\n\nreturn {\n  json: {\n    success: true,\n    query: $('Webhook').first().json.body.query,\n    result: response,\n    timestamp: new Date().toISOString(),\n    source: 'n8n-orchestrator'\n  }\n};"
      },
      "id": "process-response",
      "name": "Process Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Query Hub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Hub": {
      "main": [
        [
          {
            "node": "Process Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["hub", "query", "production"]
}
