+"""Stage A — map RawContacts onto canonical Contact dicts.
+
+Thin batch driver over models.build_contact (which owns the 50-prop mapping).
+"""
+from __future__ import annotations
+
+from ..models import CONTACT_KEYS, RawContact, build_contact
+
+
+def map_contacts(raws: list[RawContact]) -> list[dict]:
+    """RawContact list -> canonical Contact dict list."""
+    return [build_contact(r) for r in raws]
+
+
+def validate_contact(contact: dict) -> list[str]:
