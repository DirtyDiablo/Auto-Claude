+"""Stage 0 — allow-list intake.
+
+The ONLY module that copies files out of the Downloads area, and it does so strictly
+from the explicit named-file allow-list (`intake_allowlist.json`). It NEVER globs or
+trawls Downloads. Idempotent: a file whose destination already matches by sha256 is skipped.
+
+Run: python3 -m clearancejobs_pipeline.intake
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+from datetime import datetime, timezone
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+ALLOWLIST = os.path.join(HERE, "intake_allowlist.json")
+INTAKE_ROOT = os.path.join(REPO, "intake", "clearancejobs")
+
+
+def _sha256(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def run_intake(allowlist_path: str = ALLOWLIST, intake_root: str = INTAKE_ROOT) -> list:
+    from .lib.cj_id import extract_cj_id
+
+    spec = json.load(open(allowlist_path, encoding="utf-8"))
+    base_dir = spec["base_dir"]
+    entries = spec.get("files", [])
+
+    pastes_dir = os.path.join(intake_root, "pastes")
+    resumes_dir = os.path.join(intake_root, "resumes")
+    for d in (pastes_dir, resumes_dir, os.path.join(intake_root, "contacts")):
+        os.makedirs(d, exist_ok=True)
+
+    manifest = []
+    copied = skipped = missing = 0
+    for e in entries:
+        name = e["name"]
+        lane = e["lane"]
+        src = os.path.join(base_dir, name)
+        dest_dir = pastes_dir if lane == "paste" else resumes_dir
+        if not os.path.exists(src):
+            manifest.append({"name": name, "lane": lane, "status": "missing"})
+            missing += 1
+            continue
+        dest = os.path.join(dest_dir, name)
+        sha = _sha256(src)
+        if os.path.exists(dest) and _sha256(dest) == sha:
+            status = "skipped(identical)"
+            skipped += 1
+        else:
+            shutil.copy2(src, dest)
+            status = "copied"
+            copied += 1
+        manifest.append({
+            "name": name,
+            "dest": os.path.relpath(dest, REPO).replace("\\", "/"),
+            "lane": lane,
+            "cj_id": extract_cj_id(name),
+            "program_hint": e.get("program_hint"),
+            "sha256": sha,
+            "status": status,
+            "copied_at": datetime.now(timezone.utc).isoformat(),
+        })
+
+    json.dump(
+        {
+            "generated_at": datetime.now(timezone.utc).isoformat(),
+            "counts": {"copied": copied, "skipped": skipped, "missing": missing,
+                       "total": len(entries)},
+            "files": manifest,
+        },
+        open(os.path.join(intake_root, "_manifest.json"), "w", encoding="utf-8"),
+        indent=2,
+    )
+    print(f"intake: copied={copied} skipped={skipped} missing={missing} "
+          f"total={len(entries)} -> {intake_root}")
+    return manifest
+
+
+if __name__ == "__main__":
+    run_intake()
