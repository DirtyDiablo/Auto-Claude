+"""Stage D — per-program HUMINT call sheets (Markdown + CSV) + HUMINT_SUMMARY.md.
+
+Output dir defaults to outputs/booz_target_ranking/humint/ which is GITIGNORED (PII).
+A contact appears on every program it matched (recruiters for each program want them).
+"""
+from __future__ import annotations
+
+import csv
+import io
+import os
+from collections import defaultdict
+from datetime import datetime, timezone
+
+from .match_programs import load_config
+
+CSV_COLS = ["rank", "name", "title", "company", "tier", "composite_score",
+            "clearance_level", "city", "state", "relo", "hot", "cj_id",
+            "sources", "needs_review", "programs"]
+
+
+def _row(c: dict, rank: int) -> dict:
+    sm = c.get("source_metadata") or {}
+    return {
+        "rank": rank,
+        "name": c.get("name") or "",
+        "title": c.get("title") or "",
+        "company": c.get("company") or "",
+        "tier": c.get("tier") if c.get("tier") is not None else "",
+        "composite_score": c.get("composite_score") if c.get("composite_score") is not None else "",
+        "clearance_level": c.get("clearance_level") or "",
+        "city": c.get("city") or "",
+        "state": c.get("state") or "",
+        "relo": "Yes" if sm.get("relo") else ("No" if sm.get("relo") is False else ""),
+        "hot": "HOT" if sm.get("cj_last_login_hot") else "",
+        "cj_id": sm.get("cj_id") or "",
+        "sources": "; ".join(c.get("sources") or []),
+        "needs_review": c.get("needs_review"),
+        "programs": "; ".join(c.get("programs") or []),
+    }
+
+
+def _render_csv(rows: list[dict]) -> str:
+    buf = io.StringIO()
+    w = csv.DictWriter(buf, fieldnames=CSV_COLS)
+    w.writeheader()
+    for i, c in enumerate(rows, 1):
+        w.writerow(_row(c, i))
+    return buf.getvalue()
+
+
+def _render_md(piid: str, prog: dict, rows: list[dict]) -> str:
+    subs = ", ".join(prog.get("competitor_subs", [])) or "-"
+    pop = ", ".join(prog.get("pop_cities", [])) or "-"
+    hot_n = sum(1 for c in rows if (c.get("source_metadata") or {}).get("cj_last_login_hot"))
+    out = []
+    out.append(f"# HUMINT Call Sheet — {prog.get('program','?')} (`{piid}`)\n")
+    out.append(f"- **Prime:** {prog.get('prime','?')}  ·  **Agency:** {prog.get('agency','?')}")
+    out.append(f"- **Value:** ${prog.get('value_$M','?')}M  ·  **PoP end:** {prog.get('pop_end','?')}")
+    out.append(f"- **Recruit-from competitor subs:** {subs}")
+    out.append(f"- **Clearance:** {prog.get('clearance','?')}")
+    out.append(f"- **PoP metros:** {pop}")
+    out.append(f"- **Candidates:** {len(rows)}  ·  **🔥 hot (logged in today):** {hot_n}\n")
+    out.append("| # | Name | Title | Company | Tier | Score | Clearance | Location | Relo | Hot | CJ id | Source | Review |")
+    out.append("|---|------|-------|---------|------|-------|-----------|----------|------|-----|-------|--------|--------|")
+    for i, c in enumerate(rows, 1):
+        r = _row(c, i)
+        loc = f"{r['city']}, {r['state']}".strip(", ")
+        src = "resume" if "ClearanceJobs resume" in (c.get("sources") or []) else "paste"
+        review = "⚠" if c.get("needs_review") else ""
+        out.append(f"| {i} | {r['name']} | {r['title']} | {r['company']} | {r['tier']} | "
+                   f"{r['composite_score']} | {r['clearance_level']} | {loc} | {r['relo']} | "
+                   f"{'🔥' if r['hot'] else ''} | {r['cj_id']} | {src} | {review} |")
+    out.append("\n> ⚠ = needs review (paste-lane stub or collides with an existing CRM contact). "
+               "🔥 = last ClearanceJobs login was today.\n")
+    return "\n".join(out)
+
+
+def _render_summary(cfg: dict, by_piid: dict, unmatched: list, contacts: list) -> str:
+    hot_total = sum(1 for c in contacts if (c.get("source_metadata") or {}).get("cj_last_login_hot"))
+    out = []
+    out.append("# HUMINT Pipeline Summary\n")
+    out.append(f"- Generated: {datetime.now(timezone.utc).isoformat()}")
+    out.append(f"- Total resolved contacts: **{len(contacts)}**")
+    out.append(f"- Matched to >=1 program: **{sum(1 for c in contacts if c.get('programs'))}**")
+    out.append(f"- Unmatched: **{len(unmatched)}**")
+    out.append(f"- 🔥 Hot (logged in today): **{hot_total}**\n")
+    out.append("| Program | PIID | Candidates | Hot | Top score |")
+    out.append("|---------|------|-----------|-----|-----------|")
+    for piid, prog in cfg.items():
+        rows = by_piid.get(piid, [])
+        if not rows:
+            continue
+        hot = sum(1 for c in rows if (c.get("source_metadata") or {}).get("cj_last_login_hot"))
+        top = max((c.get("composite_score") or 0) for c in rows)
+        out.append(f"| {prog.get('program','?')} | `{piid}` | {len(rows)} | {hot} | {top} |")
+    if unmatched:
+        out.append(f"\n## Unmatched ({len(unmatched)})\n")
+        out.append("Persisted with `programs=[]` — review for off-program relevance.\n")
+        for c in unmatched[:50]:
+            loc = f"{c.get('city') or ''}, {c.get('state') or ''}".strip(", ")
+            out.append(f"- {c.get('name')} — {c.get('title') or '?'} — {c.get('company') or '?'} — {loc}")
+    return "\n".join(out)
+
+
+def write_call_sheets(contacts: list[dict], config: dict | None = None,
+                      out_dir: str = "outputs/booz_target_ranking/humint") -> list[str]:
+    cfg = config if config is not None else load_config()
+    os.makedirs(out_dir, exist_ok=True)
+    by_piid: dict[str, list] = defaultdict(list)
+    unmatched: list = []
+    for c in contacts:
+        if c.get("programs"):
+            for piid in c["programs"]:
+                by_piid[piid].append(c)
+        else:
+            unmatched.append(c)
+    written: list[str] = []
+    for piid, prog in cfg.items():
+        rows = by_piid.get(piid, [])
+        if not rows:
+            continue
+        rows = sorted(rows, key=lambda c: (-(c.get("composite_score") or 0), c.get("tier") or 6))
+        mp = os.path.join(out_dir, f"{piid}_callsheet.md")
+        cp = os.path.join(out_dir, f"{piid}_callsheet.csv")
+        with open(mp, "w", encoding="utf-8") as fh:
+            fh.write(_render_md(piid, prog, rows))
+        with open(cp, "w", newline="", encoding="utf-8-sig") as fh:
+            fh.write(_render_csv(rows))
+        written += [mp, cp]
+    sp = os.path.join(out_dir, "HUMINT_SUMMARY.md")
+    with open(sp, "w", encoding="utf-8") as fh:
+        fh.write(_render_summary(cfg, by_piid, unmatched, contacts))
+    written.append(sp)
+    return written
