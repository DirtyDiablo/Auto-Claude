+"""ClearanceJobs result-list paste parser.
+
+Parses plain-text pastes exported from the ClearanceJobs candidate search results page.
+Each paste begins with a short header section and then a sequence of candidate blocks,
+each terminated by a lone uppercase initial letter OR the literal "user avatar".
+
+Public API
+----------
+parse_paste(path, program_hint=None)  -> list[RawContact]
+parse_paste_text(text, source_file="", program_hint=None) -> list[RawContact]
+"""
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+from clearancejobs_pipeline.models import LANE_PASTE, RawContact
+from clearancejobs_pipeline.lib.companies import canonical_company
+
+# ---------------------------------------------------------------------------
+# Compiled patterns (module-level — compiled once)
+# ---------------------------------------------------------------------------
+
+# Header-sentinel: skip everything up to and including the sort-field line
+_RE_VIEWING = re.compile(r"^Viewing\s+\d", re.I)
+_RE_CANDIDATES = re.compile(r"^Candidates\s*$", re.I)
+_RE_SHOW = re.compile(r"^\d+\s+per\s+page\s*$", re.I)
+_RE_SORT_BY = re.compile(r"^Sort\s+by:\s*$", re.I)
+
+# Block terminator: a lone uppercase letter or "user avatar"
+_RE_AVATAR_TERM = re.compile(r"^user\s+avatar\s*$", re.I)
+_RE_INITIAL = re.compile(r"^[A-Z]$")
+
+# Classifier patterns
+_RE_CLEARANCE = re.compile(
+    r"TS/SCI(\s+w\s+Poly)?|Top\s+Secret|Secret|Public\s+Trust|Confidential", re.I
+)
+_RE_SENIORITY = re.compile(
+    r"^(\d+\+\s+yrs?\s+exp|Mgr/Director|Entry[- ]Level|Junior\b|Senior\b)\s*$", re.I
+)
+_RE_RELO = re.compile(r"^(Yes|No)\s+-\s+(Open\s+to\s+relo|Not\s+open\s+to\s+relo)\s*$", re.I)
+_RE_SALARY = re.compile(r"^\$[\d,]+\s*$")
+# Date-like: "Today", "Yesterday", "May 20", "Jun 19, 2025", "Mar 10", "Feb 24"
+_RE_DATE = re.compile(
+    r"^(Today|Yesterday|[A-Z][a-z]{2}\s+\d{1,2}(,\s*\d{4})?)\s*$"
+)
+# City/State: "Baltimore, MD"  "Port Huron Township, MI"
+_RE_CITY_STATE = re.compile(
+    r"^(?P<city>[A-Za-z][A-Za-z .,''\-]+),\s*(?P<state>[A-Z]{2})\s*$"
+)
+
+
+# ---------------------------------------------------------------------------
+# Header stripping
+# ---------------------------------------------------------------------------
+
+def _strip_header(lines: list[str]) -> list[str]:
+    """Remove the boilerplate header lines that precede the first candidate.
+
+    The header pattern is:
+        Viewing N - M of K
+        Candidates
+        Show:
+        N per page
+        Sort by:
+        <sort field value, e.g. "Last Login Date (Des)">
+
+    We walk forward and drop each matching line. Once we've seen the "Sort by:"
+    marker we also drop the very next line (the sort field value) then return
+    the rest. If no header markers are found the original list is returned
+    unchanged.
+    """
+    result = list(lines)
+    drop_next = False  # True after "Sort by:" line is consumed
+    out = []
+    header_done = False
+    saw_sort_by = False
+
+    for line in result:
+        stripped = line.strip()
+        if header_done:
+            out.append(line)
+            continue
+
+        if drop_next:
+            # This is the sort field value — drop it and close header
+            drop_next = False
+            header_done = True
+            continue
+
+        if _RE_VIEWING.match(stripped):
+            continue
+        if _RE_CANDIDATES.match(stripped):
+            continue
+        # "Show:" bare label — drop
+        if stripped.lower() == "show:":
+            continue
+        if _RE_SHOW.match(stripped):
+            continue
+        if _RE_SORT_BY.match(stripped):
+            saw_sort_by = True
+            drop_next = True
+            continue
+
+        # A line that doesn't match any header pattern and we haven't seen
+        # the Sort-by marker yet — treat header as absent, keep everything.
+        if not saw_sort_by:
+            return result  # no header detected; return full list unchanged
+        out.append(line)
+
+    if not header_done and not drop_next:
+        # Fell off the end without closing — return everything after removing
+        # the header lines we did match
+        return out
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Block splitter
+# ---------------------------------------------------------------------------
+
+def _split_blocks(lines: list[str]) -> list[list[str]]:
+    """Split line list into candidate blocks.
+
+    A block ends when a TERMINATOR line is encountered (lone uppercase initial
+    OR "user avatar"). The terminator itself is not included in the block.
+    A trailing block (no terminator at EOF) is included.
+    """
+    blocks: list[list[str]] = []
+    current: list[str] = []
+
+    for line in lines:
+        stripped = line.strip()
+        if not stripped:
+            # blank lines inside a block are ignored
+            continue
+        if _RE_AVATAR_TERM.match(stripped) or _RE_INITIAL.match(stripped):
+            if current:
+                blocks.append(current)
+                current = []
+        else:
+            current.append(stripped)
+
+    if current:
+        blocks.append(current)
+
+    return blocks
+
+
+# ---------------------------------------------------------------------------
+# Per-block classifier
+# ---------------------------------------------------------------------------
+
+def _classify_line(line: str) -> str:
+    """Return the classifier label for a single line."""
+    if _RE_CLEARANCE.search(line):
+        return "clearance"
+    if _RE_SENIORITY.match(line):
+        return "seniority"
+    if _RE_RELO.match(line):
+        return "relo"
+    if _RE_SALARY.match(line):
+        return "salary"
+    if _RE_DATE.match(line):
+        return "date"
+    if _RE_CITY_STATE.match(line):
+        return "city_state"
+    return "text"
+
+
+def _parse_block(
+    block: list[str],
+    source_file: str,
+    program_hint: Optional[str],
+) -> Optional[RawContact]:
+    """Parse a single candidate block into a RawContact.
+
+    Returns None if the block is too short to produce a valid contact (no name).
+    Raises nothing — errors are logged by the caller; see parse_paste_text.
+    """
+    if len(block) < 1:
+        return None
+
+    name = block[0].strip()
+    if not name:
+        return None
+
+    title = block[1].strip() if len(block) > 1 else ""
+    rest = block[2:]
+
+    clearance_level = ""
+    clearances: list[str] = []
+    seniority_band = ""
+    relo: Optional[bool] = None
+    salary_expectation = ""
+    cj_last_login = ""
+    city = ""
+    state = ""
+    text_lines: list[str] = []
+
+    date_count = 0  # only first date line = cj_last_login; subsequent = profile updated
+
+    for line in rest:
+        label = _classify_line(line)
+
+        if label == "clearance":
+            # Grab the first clearance mention as clearance_level
+            m = _RE_CLEARANCE.search(line)
+            if m:
+                matched = m.group(0)
+                # Normalise partial-match fragments like "TS/SCI" (already good)
+                if not clearance_level:
+                    clearance_level = matched
+                clearances.append(matched)
+            # The whole line may also contain text; don't add to text_lines here
+            # since it might be a keyword-thumbnail line that ALSO has a clearance term —
+            # keep it as text if it's not a bare clearance-only line.
+            # Heuristic: if the line has > 6 tokens, treat it as a keyword-thumbnail
+            # too, otherwise classify as clearance-only.
+            if len(line.split()) > 4:
+                text_lines.append(line)
+
+        elif label == "seniority":
+            if not seniority_band:
+                seniority_band = line
+
+        elif label == "relo":
+            relo = line.lower().startswith("yes")
+
+        elif label == "salary":
+            if not salary_expectation:
+                salary_expectation = line.strip()
+
+        elif label == "date":
+            date_count += 1
+            if date_count == 1:
+                cj_last_login = line.strip()
+            # subsequent date lines are ignored
+
+        elif label == "city_state":
+            if not city:
+                m = _RE_CITY_STATE.match(line)
+                if m:
+                    city = m.group("city").strip()
+                    state = m.group("state").strip()
+
+        else:
+            # label == "text" — keyword/thumbnail freeform lines
+            text_lines.append(line)
+
+    keyword_thumbnail = " ".join(text_lines).strip()
+
+    # Employer canonicalization
+    company_raw = keyword_thumbnail
+    company = canonical_company(keyword_thumbnail) or ""
+
+    cj_last_login_hot = cj_last_login.lower() == "today"
+
+    return RawContact(
+        lane=LANE_PASTE,
+        source_file=source_file,
+        name=name,
+        title=title,
+        city=city,
+        state=state,
+        clearance_level=clearance_level,
+        clearances=clearances,
+        seniority_band=seniority_band,
+        relo=relo,
+        salary_expectation=salary_expectation,
+        cj_last_login=cj_last_login,
+        cj_last_login_hot=cj_last_login_hot,
+        keyword_thumbnail=keyword_thumbnail,
+        company_raw=company_raw,
+        company=company,
+        program_hint=program_hint,
+        confidence="C",
+        needs_review=True,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Public API
+# ---------------------------------------------------------------------------
+
+def parse_paste_text(
+    text: str,
+    source_file: str = "",
+    program_hint: Optional[str] = None,
+) -> list[RawContact]:
+    """Parse raw paste text into a list of RawContact records.
+
+    Parameters
+    ----------
+    text:
+        Full text of a ClearanceJobs result-list paste.
+    source_file:
+        Filename/path to record in source_file field (no PII read here).
+    program_hint:
+        Optional contract PIID or program name sourced from the paste context.
+
+    Returns
+    -------
+    list[RawContact] — one per detected candidate block (empty on failure).
+    """
+    if not text or not text.strip():
+        return []
+
+    lines = text.splitlines()
+    lines = _strip_header(lines)
+    blocks = _split_blocks(lines)
+
+    contacts: list[RawContact] = []
+    for block in blocks:
+        try:
+            rc = _parse_block(block, source_file, program_hint)
+            if rc is not None:
+                contacts.append(rc)
+        except Exception:  # noqa: BLE001
+            # Malformed block: skip without crashing the whole parse
+            continue
+
+    return contacts
+
+
+def parse_paste(
+    path: str,
+    program_hint: Optional[str] = None,
+) -> list[RawContact]:
+    """Read a paste file and return parsed RawContacts.
+
+    Parameters
+    ----------
+    path:
+        Absolute or relative path to the .txt paste file.
+    program_hint:
+        Optional PIID / program hint forwarded to each RawContact.
+    """
+    with open(path, encoding="utf-8", errors="replace") as fh:
+        text = fh.read()
+    return parse_paste_text(text, source_file=path, program_hint=program_hint)
