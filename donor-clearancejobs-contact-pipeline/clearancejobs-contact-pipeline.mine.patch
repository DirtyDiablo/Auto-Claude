new file mode 100644
index 000000000..4f8a46ac5
--- /dev/null
+++ b/clearancejobs_pipeline/run.py
@@ -0,0 +1,131 @@
+"""Orchestrate Stage 0 -> D.
+
+  python3 -m clearancejobs_pipeline.run                 # deterministic (default, fast)
+  python3 -m clearancejobs_pipeline.run --ollama        # + local Ollama resume enrichment
+  python3 -m clearancejobs_pipeline.run --skip-intake   # reuse already-copied intake/
+  python3 -m clearancejobs_pipeline.run --config <path> --out <dir>   # reuse for another prime
+
+Writes canonical per-contact JSON to intake/clearancejobs/contacts/ (gitignored) and
+per-program call sheets to --out (gitignored). A run report lands at
+intake/clearancejobs/_run_report.json.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+from datetime import datetime, timezone
+
+# CJ result-list chrome that can leak into a block when a paste concatenates multiple
+# result pages or includes the left filter sidebar (pagination headers, "Boolean search",
+# clearance-filter labels, etc.). Checked against both the parsed name AND title.
+_JUNK_RE = re.compile(
+    r"viewing\s+\d+\s*-|\bshow:|sort by|^\s*candidates\s*$|\d+\s+per page"
+    r"|boolean search|last login date",
+    re.I,
+)
+
+
+def _is_junk_paste(rc) -> bool:
+    if not rc.name:
+        return True
+    return bool(_JUNK_RE.search(rc.name) or _JUNK_RE.search(rc.title or ""))
+
+from .intake import INTAKE_ROOT, REPO, run_intake
+from .spine.call_sheet import write_call_sheets
+from .spine.map_contact import map_contacts
+from .spine.match_programs import DEFAULT_CONFIG, load_config, match_all
+from .spine.resolve import dedupe, flag_against_existing
+
+
+def _collect_raws(manifest: list, use_ollama: bool):
+    from .lanes.paste import parse_paste
+    from .lanes.resume import parse_resume
+
+    raws = []
+    errors = []
+    for m in manifest:
+        if m.get("status") == "missing":
+            continue
+        dest = os.path.join(REPO, m["dest"])
+        lane = m.get("lane")
+        hint = m.get("program_hint")
+        try:
+            if lane == "paste":
+                for rc in (parse_paste(dest, program_hint=hint) or []):
+                    if not _is_junk_paste(rc):
+                        raws.append(rc)
+            else:
+                rc = parse_resume(dest, program_hint=hint, use_ollama=use_ollama)
+                if rc:
+                    raws.append(rc)
+        except Exception as e:  # per-file isolation — never abort the batch
+            errors.append({"file": m.get("name"), "lane": lane, "error": repr(e)})
+    return raws, errors
+
+
+def run_pipeline(use_ollama=False, config_path=DEFAULT_CONFIG,
+                 out_dir=None, skip_intake=False, existing_check=True):
+    out_dir = out_dir or os.path.join(REPO, "outputs", "booz_target_ranking", "humint")
+    if not skip_intake:
+        run_intake()
+    manifest = json.load(open(os.path.join(INTAKE_ROOT, "_manifest.json"), encoding="utf-8"))["files"]
+
+    raws, errors = _collect_raws(manifest, use_ollama)
+    contacts = map_contacts(raws)
+    contacts = dedupe(contacts)
+    if existing_check:
+        contacts = flag_against_existing(contacts)
+    cfg = load_config(config_path)
+    contacts = match_all(contacts, cfg)
+
+    cdir = os.path.join(INTAKE_ROOT, "contacts")
+    os.makedirs(cdir, exist_ok=True)
+    for c in contacts:
+        key = (c.get("_local_key") or "unknown").replace(":", "_").replace("|", "_").replace("/", "_")
+        with open(os.path.join(cdir, f"{key}.json"), "w", encoding="utf-8") as fh:
+            json.dump(c, fh, indent=2, ensure_ascii=False)
+
+    paths = write_call_sheets(contacts, cfg, out_dir)
+
+    report = {
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "n_raw": len(raws),
+        "n_contacts": len(contacts),
+        "n_matched": sum(1 for c in contacts if c.get("programs")),
+        "n_hot": sum(1 for c in contacts if (c.get("source_metadata") or {}).get("cj_last_login_hot")),
+        "ollama": use_ollama,
+        "errors": errors,
+        "call_sheets": [os.path.relpath(p, REPO).replace("\\", "/") for p in paths],
+    }
+    with open(os.path.join(INTAKE_ROOT, "_run_report.json"), "w", encoding="utf-8") as fh:
+        json.dump(report, fh, indent=2)
+    return report
+
+
+def main():
+    ap = argparse.ArgumentParser(description="ClearanceJobs -> Contact -> call sheets")
+    ap.add_argument("--ollama", action="store_true", help="enable local Ollama resume enrichment")
+    ap.add_argument("--config", default=DEFAULT_CONFIG)
+    ap.add_argument("--out", default=None)
+    ap.add_argument("--skip-intake", action="store_true")
+    ap.add_argument("--no-existing-check", action="store_true")
+    args = ap.parse_args()
+
+    rep = run_pipeline(
+        use_ollama=args.ollama,
+        config_path=args.config,
+        out_dir=args.out,
+        skip_intake=args.skip_intake,
+        existing_check=not args.no_existing_check,
+    )
+    print(f"raws={rep['n_raw']} contacts={rep['n_contacts']} matched={rep['n_matched']} "
+          f"hot={rep['n_hot']} errors={len(rep['errors'])}")
+    for e in rep["errors"][:10]:
+        print("  ERR", e)
+    print("call sheets:", len(rep["call_sheets"]))
+
+
+if __name__ == "__main__":
+    main()
