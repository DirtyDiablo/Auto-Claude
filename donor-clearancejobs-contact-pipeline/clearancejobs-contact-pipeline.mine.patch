@@ -0,0 +1,40 @@
+"""Extract the ClearanceJobs candidate ID (and a name slug) from a resume filename.
+
+Observed filename shapes:
+  jalen-pestillo-2032428.pdf                 -> 2032428
+  clearancejobs.com_resumes_701487_resume.pdf-> 701487
+  anonymous19032-2466200.docx                -> 2466200
+  anonymous1239799-2581233.docx              -> 2581233
+  Charles Dunkin.pdf                         -> None (name-only)
+"""
+from __future__ import annotations
+
+import os
+import re
+
+_RESUMES = re.compile(r"_resumes_(\d{4,})_", re.I)
+_TRAILING = re.compile(r"-(\d{4,})(?:\.[A-Za-z0-9]+)?$")
+
+
+def extract_cj_id(filename: str) -> str | None:
+    """Return the CJ candidate id string, or None when the filename has none."""
+    base = os.path.basename(filename or "")
+    stem = os.path.splitext(base)[0]
+    m = _RESUMES.search(base)
+    if m:
+        return m.group(1)
+    m = _TRAILING.search(stem)
+    if m:
+        return m.group(1)
+    return None
+
+
+def name_slug_from_filename(filename: str) -> str:
+    """Best-effort person slug from filename (fallback dedup key when no CJ id)."""
+    base = os.path.basename(filename or "")
+    stem = os.path.splitext(base)[0]
+    stem = re.sub(r"clearancejobs\.com_resumes_\d+_?", "", stem, flags=re.I)
+    stem = re.sub(r"_?resume$", "", stem, flags=re.I)
+    stem = re.sub(r"-?\d{4,}$", "", stem)          # drop trailing CJ id
+    stem = re.sub(r"^anonymous\d*", "anonymous", stem, flags=re.I)
+    return re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-")
