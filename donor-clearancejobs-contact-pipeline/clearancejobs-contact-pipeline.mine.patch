+"""Resume lane — parse a resume file (PDF/DOCX/DOC) into a single RawContact.
+
+Privacy constraint: ALL parsing is 100% local. No cloud endpoints are called
+unless `use_ollama=True`, which routes to localhost:11434 only.
+
+Public API
+----------
+parse_resume(path, *, program_hint, use_ollama, ollama_model) -> RawContact
+extract_fields(text, filename) -> dict   # pure, testable without a real file
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+from typing import Optional
+
+from clearancejobs_pipeline.models import LANE_RESUME, RawContact
+from clearancejobs_pipeline.lib.cj_id import extract_cj_id, name_slug_from_filename
+from clearancejobs_pipeline.lib.companies import canonical_company, COMPANY_PATS
+
+# ---------------------------------------------------------------------------
+# Clearance hierarchy for ranking
+# ---------------------------------------------------------------------------
+_CLEARANCE_RANK = {
+    "TS/SCI w/ Poly": 5,
+    "TS/SCI w/Poly":  5,
+    "TS/SCI":         4,
+    "Top Secret":     3,
+    "Secret":         2,
+    "DoD Secret":     2,
+    "Interim Secret": 1,
+    "Public Trust":   0,
+}
+
+_CLEARANCE_RE = re.compile(
+    r"TS/SCI\s*(?:w/?[\s]?Poly|with\s+poly(?:graph)?)"
+    r"|TS/SCI"
+    r"|Top\s+Secret"
+    r"|DoD\s+Secret"
+    r"|Interim\s+Secret"
+    r"|Public\s+Trust"
+    r"|\bSecret\b",
+    re.I,
+)
+
+# Normalise matched text -> canonical label
+def _normalise_clearance(raw: str) -> str:
+    s = raw.strip()
+    if re.search(r"TS/SCI\s*(?:w/?[\s]?Poly|with\s+poly(?:graph)?)", s, re.I):
+        return "TS/SCI w/ Poly"
+    if re.search(r"TS/SCI", s, re.I):
+        return "TS/SCI"
+    if re.search(r"Top\s+Secret", s, re.I):
+        return "Top Secret"
+    if re.search(r"DoD\s+Secret", s, re.I):
+        return "DoD Secret"
+    if re.search(r"Interim\s+Secret", s, re.I):
+        return "Interim Secret"
+    if re.search(r"Public\s+Trust", s, re.I):
+        return "Public Trust"
+    if re.search(r"\bSecret\b", s, re.I):
+        return "Secret"
+    return s
+
+
+# ---------------------------------------------------------------------------
+# Local file → text
+# ---------------------------------------------------------------------------
+
+def _parse_pdf(path: str) -> tuple[str, str]:
+    """Return (text, engine_name). Tries liteparse → pdfplumber → fitz."""
+    text = ""
+
+    # 1. liteparse (preferred – Rust-based, fastest). OCR disabled: Tesseract is not
+    # installed here, so OCR would only spam stderr and add no text.
+    try:
+        from liteparse import LiteParse, ParseError
+        parser = LiteParse(quiet=True, ocr_enabled=False)
+        result = parser.parse(path)
+        text = result.text or ""
+        if text.strip():
+            return text, "liteparse"
+    except Exception:
+        pass
+
+    # 2. pdfplumber
+    try:
+        import pdfplumber
+        with pdfplumber.open(path) as pdf:
+            text = "\n".join(page.extract_text() or "" for page in pdf.pages)
+        if text.strip():
+            return text, "pdfplumber"
+    except Exception:
+        pass
+
+    # 3. fitz / PyMuPDF
+    try:
+        import fitz
+        doc = fitz.open(path)
+        text = "\n".join(page.get_text() for page in doc)
+        if text.strip():
+            return text, "fitz"
+    except Exception:
+        pass
+
+    return "", "none"
+
+
+def _parse_docx(path: str) -> tuple[str, str]:
+    """Return (text, engine_name). Tries mammoth → python-docx."""
+    # 1. mammoth
+    try:
+        import mammoth
+        with open(path, "rb") as fh:
+            result = mammoth.extract_raw_text(fh)
+        text = result.value or ""
+        if text.strip():
+            return text, "mammoth"
+    except Exception:
+        pass
+
+    # 2. python-docx
+    try:
+        import docx
+        doc = docx.Document(path)
+        text = "\n".join(p.text for p in doc.paragraphs)
+        if text.strip():
+            return text, "python-docx"
+    except Exception:
+        pass
+
+    return "", "none"
+
+
+def _parse_doc(path: str) -> tuple[str, str]:
+    """Return (text, engine_name) for old binary .doc files.
+
+    Tries liteparse (needs LibreOffice) only; on failure returns empty string
+    so the caller can build a minimal RawContact from the filename.
+    """
+    try:
+        from liteparse import LiteParse
+        parser = LiteParse(quiet=True, ocr_enabled=False)
+        result = parser.parse(path)
+        text = result.text or ""
+        if text.strip():
+            return text, "liteparse"
+    except Exception:
+        pass
+
+    return "", "unsupported"
+
+
+def _extract_text(path: str) -> tuple[str, str, str]:
+    """Return (text, engine, ext). Never raises — bad files return empty text."""
+    ext = os.path.splitext(path)[1].lower()
+    try:
+        if ext == ".pdf":
+            text, engine = _parse_pdf(path)
+        elif ext == ".docx":
+            text, engine = _parse_docx(path)
+        elif ext == ".doc":
+            text, engine = _parse_doc(path)
+        else:
+            # Unsupported extension — try PDF stack then docx stack
+            text, engine = _parse_pdf(path)
+            if not text.strip():
+                text, engine = _parse_docx(path)
+    except Exception:
+        text, engine = "", "error"
+    return text, engine, ext
+
+
+# ---------------------------------------------------------------------------
+# Deterministic field extraction (pure — testable on a string)
+# ---------------------------------------------------------------------------
+
+_EMAIL_RE = re.compile(r"[\w.+\-]+@[\w\-]+\.[\w.\-]+")
+_PHONE_RE = re.compile(
+    r"(?:\+?1[\s.\-]?)?"
+    r"(?:\(?\d{3}\)?[\s.\-]?)?"
+    r"\d{3}[\s.\-]\d{4}"
+)
+_LINKEDIN_RE = re.compile(
+    r"https?://(?:www\.)?linkedin\.com/in/[\w%\-/]+",
+    re.I,
+)
+_CITY_STATE_RE = re.compile(
+    r"\b([A-Z][A-Za-z .'\-]{1,30}),\s*([A-Z]{2})\b"
+)
+_SKILLS_SECTION_RE = re.compile(
+    r"(?:Technical\s+Skills?|Skills?|Core\s+Competencies|Expertise)"
+    r"\s*[:\n]+\s*([^\n]{10,}(?:\n[^\n]{5,}){0,8})",
+    re.I,
+)
+
+
+_NAME_STOPWORDS = frozenset({
+    "engineer", "engineer", "engineering", "developer", "analyst", "manager",
+    "director", "senior", "junior", "lead", "principal", "staff", "associate",
+    "specialist", "scientist", "architect", "consultant", "advisor", "contractor",
+    "professional", "coordinator", "technician", "administrator", "officer",
+    "software", "systems", "system", "network", "cyber", "security", "cloud",
+    "data", "information", "technical", "technology", "program", "project",
+    "experience", "summary", "objective", "education", "skills", "history",
+    "work", "employment", "profile", "overview", "qualifications",
+})
+
+
+def _best_name_from_text(text: str) -> str:
+    """Look for a capitalised 2-3 word person name in the first ~10 non-empty lines.
+
+    Rejects lines that contain job-title stopwords (e.g. 'Lead Software Engineer').
+    Only matches lines that look like personal names: capitalised words, no digits,
+    no slashes, no special chars.
+    """
+    lines = [l.strip() for l in text.splitlines() if l.strip()]
+    # Two or three capitalised words on a line by itself
+    name_re = re.compile(r"^([A-Z][a-z]+(?:\s+[A-Z]\.?)?\s+[A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)$")
+    for line in lines[:10]:
+        m = name_re.match(line)
+        if not m:
+            continue
+        # Reject if any word is a known title/role stopword
+        words_lower = set(line.lower().split())
+        if words_lower & _NAME_STOPWORDS:
+            continue
+        # Reject lines with digits or special chars beyond hyphens
+        if re.search(r"[0-9/\\@#$%^&*()+=\[\]{}<>]", line):
+            continue
+        return m.group(1)
+    return ""
+
+
+def extract_fields(text: str, filename: str) -> dict:
+    """Pure extraction from resume text + filename. No file I/O.
+
+    Returns a dict with keys matching RawContact fields. The caller assembles
+    the RawContact so unit tests can work on plain strings.
+    """
+    result: dict = {}
+
+    # --- identity from filename (reliable even for anonymised resumes) ---
+    cj_id = extract_cj_id(filename)
+    slug = name_slug_from_filename(filename)
+    # title-case slug parts as a fallback name
+    slug_name = " ".join(p.capitalize() for p in slug.split("-") if p and not p.isdigit())
+    slug_name = slug_name.strip()
+
+    # prefer explicit name from top of resume if not anonymised
+    doc_name = _best_name_from_text(text)
+    # suppress anonymous/generic slugs
+    if slug.startswith("anonymous") or not slug or slug in ("resume",):
+        name = doc_name or ""
+    else:
+        name = slug_name if slug_name else doc_name
+
+    result["cj_id"] = cj_id
+    result["name"] = name
+
+    # --- contact info ---
+    email_m = _EMAIL_RE.search(text)
+    result["email"] = email_m.group(0) if email_m else ""
+
+    phone_m = _PHONE_RE.search(text)
+    result["phone"] = phone_m.group(0).strip() if phone_m else ""
+
+    li_m = _LINKEDIN_RE.search(text)
+    result["linkedin_url"] = li_m.group(0).strip("/") if li_m else ""
+
+    # --- location (look for City, ST near top first, else anywhere) ---
+    city, state = "", ""
+    top_text = "\n".join(text.splitlines()[:30])
+    cs_m = _CITY_STATE_RE.search(top_text)
+    if not cs_m:
+        cs_m = _CITY_STATE_RE.search(text)
+    if cs_m:
+        city = cs_m.group(1).strip()
+        state = cs_m.group(2).strip()
+    result["city"] = city
+    result["state"] = state
+
+    # --- clearances ---
+    found_clearances = []
+    for m in _CLEARANCE_RE.finditer(text):
+        label = _normalise_clearance(m.group(0))
+        if label not in found_clearances:
+            found_clearances.append(label)
+
+    # pick highest ranked
+    clearance_level = ""
+    if found_clearances:
+        clearance_level = max(found_clearances, key=lambda c: _CLEARANCE_RANK.get(c, -1))
+
+    result["clearances"] = found_clearances
+    result["clearance_level"] = clearance_level
+
+    # --- employer / company ---
+    # Try canonical match across full text
+    canon = canonical_company(text)
+    # Also scan for all canonical hits to build prior_companies list
+    all_canon: list[str] = []
+    for cname in COMPANY_PATS:
+        pat = COMPANY_PATS[cname]
+        if pat.search(text):
+            all_canon.append(cname)
+
+    # Best raw employer from experience section (look for first job-header line)
+    # Pattern: lines like "Title – Company" or "Title, Company" or just "Company" near experience header
+    employer_raw = ""
+    exp_re = re.compile(
+        r"(?:experience|work\s+history|employment)",
+        re.I,
+    )
+    exp_m = exp_re.search(text)
+    if exp_m:
+        window = text[exp_m.end(): exp_m.end() + 800]
+        # Look for a line that looks like employer/title
+        for line in window.splitlines():
+            line = line.strip()
+            if len(line) > 5 and not re.match(r"^\d", line):
+                # skip bullet lines
+                if not line.startswith(("•", "-", "–", "*", "◆", "▸")):
+                    employer_raw = line
+                    break
+
+    company = canon if canon else ""
+    company_raw = employer_raw or canon or ""
+
+    # prior companies = all canonical hits except the primary
+    prior = [c for c in all_canon if c != canon]
+    if canon and canon not in all_canon:
+        pass  # canon came from general scan
+
+    result["company"] = company
+    result["company_raw"] = company_raw
+    result["prior_companies"] = prior
+
+    # --- skills (light keyword pull from Skills section) ---
+    skills: list[str] = []
+    sm = _SKILLS_SECTION_RE.search(text)
+    if sm:
+        raw_skills = sm.group(1)
+        # Split on commas, bullets, semicolons, newlines
+        items = re.split(r"[,\n;•\|]+", raw_skills)
+        for item in items:
+            s = item.strip().strip("-–•*▸◆").strip()
+            if 2 < len(s) < 50 and not re.match(r"^\d+$", s):
+                skills.append(s)
+                if len(skills) >= 20:
+                    break
+    result["skills"] = skills
+
+    # --- title (look for title/role near the top or in first experience entry) ---
+    title = ""
+    # first experience line after date pattern often contains Title – Company
+    title_re = re.compile(
+        r"(?:(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s*\d{4}"
+        r"|\d{4})\s*[-–]\s*(?:(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s*\d{4}"
+        r"|present|current|now)",
+        re.I,
+    )
+    date_m = title_re.search(text)
+    if date_m:
+        # look at the line before/after the date for role
+        before_date = text[max(0, date_m.start() - 200): date_m.start()]
+        lines_before = [l.strip() for l in before_date.splitlines() if l.strip()]
+        if lines_before:
+            candidate = lines_before[-1]
+            if len(candidate) < 80 and not re.match(r"^\d", candidate):
+                title = candidate
+
+    result["title"] = title
+
+    # --- confidence ---
+    has_email = bool(result["email"])
+    has_phone_or_li = bool(result["phone"]) or bool(result["linkedin_url"])
+    has_company = bool(result["company"] or result["company_raw"])
+    confidence = "A" if (has_email and has_phone_or_li and has_company) else "B"
+    result["confidence"] = confidence
+    result["needs_review"] = (confidence != "A")
+
+    return result
+
+
+# ---------------------------------------------------------------------------
+# Optional Ollama enrichment
+# ---------------------------------------------------------------------------
+
+def _enrich_ollama(text: str, fields: dict, model: str) -> dict:
+    """Call local Ollama and merge results. Graceful degrade on any failure."""
+    import requests  # stdlib-like, safe
+
+    prompt = (
+        "You are a resume parser. Extract ONLY these fields from the resume text below.\n"
+        "Return STRICT JSON only (no markdown, no explanation):\n"
+        '{"normalized_title": "<job title>", "role_family": "<e.g. Software Engineer>", '
+        '"skills": ["<skill1>", ...], "summary": "<one sentence summary>"}\n\n'
+        f"RESUME TEXT (first 3500 chars):\n{text[:3500]}"
+    )
+
+    try:
+        resp = requests.post(
+            "http://127.0.0.1:11434/api/generate",
+            # Bounded num_ctx keeps the memory estimate small (the default 128k context
+            # is what makes Ollama demand 11-16 GiB). 2048 fits a ~3.5k-char resume + output.
+            json={"model": model, "prompt": prompt, "stream": False,
+                  "options": {"num_ctx": 2048, "num_predict": 400, "temperature": 0}},
+            timeout=180,
+        )
+        resp.raise_for_status()
+        raw = resp.json().get("response", "")
+        # Extract JSON block (model may wrap in text)
+        json_m = re.search(r"\{.*\}", raw, re.DOTALL)
+        if not json_m:
+            raise ValueError("no JSON in ollama response")
+        parsed = json.loads(json_m.group(0))
+    except Exception:
+        fields["extra"] = {**fields.get("extra", {}), "ollama": "unavailable"}
+        return fields
+
+    # Prefer the LLM-normalized title over the regex heuristic (which often grabs a noisy
+    # date-adjacent line); fall back to the deterministic title only when the LLM gave nothing.
+    if parsed.get("normalized_title"):
+        fields["title"] = parsed["normalized_title"]
+
+    # Extend skills (deduplicated)
+    existing_skills = list(fields.get("skills", []))
+    for s in parsed.get("skills", []):
+        if s and s not in existing_skills:
+            existing_skills.append(s)
+    fields["skills"] = existing_skills[:30]
+
+    # Summary → extra["pain_points"]
+    summary = parsed.get("summary", "").strip()
+    if summary:
+        extra = fields.get("extra", {})
+        extra["pain_points"] = [summary]
+        fields["extra"] = extra
+
+    return fields
+
+
+# ---------------------------------------------------------------------------
+# Public entry-point
+# ---------------------------------------------------------------------------
+
+def parse_resume(
+    path: str,
+    *,
+    program_hint: Optional[str] = None,
+    use_ollama: bool = False,
+    ollama_model: str = "llama3.2:3b",
+) -> RawContact:
+    """Parse a resume file into a RawContact.
+
+    Parameters
+    ----------
+    path : str
+        Absolute or relative path to a PDF / DOCX / DOC file.
+    program_hint : str | None
+        Optional PIID / program the resume was sourced under.
+    use_ollama : bool
+        Whether to call local Ollama for LLM enrichment (title, skills, summary).
+    ollama_model : str
+        Ollama model tag (default: llama3.1:8b).
+    """
+    filename = os.path.basename(path)
+
+    # 1. Parse file to text
+    text, parse_engine, ext = _extract_text(path)
+
+    # Build base extra dict
+    extra: dict = {"parse_engine": parse_engine}
+
+    # DOC files that failed to parse → minimal RawContact from filename
+    if ext == ".doc" and not text.strip():
+        extra["parse_status"] = "doc_unsupported"
+        cj_id = extract_cj_id(filename)
+        slug = name_slug_from_filename(filename)
+        name = " ".join(p.capitalize() for p in slug.split("-") if p and not p.isdigit()).strip()
+        return RawContact(
+            lane=LANE_RESUME,
+            source_file=path,
+            cj_id=cj_id,
+            name=name,
+            program_hint=program_hint,
+            confidence="C",
+            needs_review=True,
+            extra=extra,
+        )
+
+    # 2. Deterministic extraction
+    fields = extract_fields(text, filename)
+    fields.setdefault("extra", {})
+    fields["extra"].update(extra)
+
+    # 3. Optional Ollama enrichment
+    if use_ollama and text.strip():
+        fields = _enrich_ollama(text, fields, ollama_model)
+
+    # 4. Assemble RawContact
+    name = fields.get("name", "")
+    rc = RawContact(
+        lane=LANE_RESUME,
+        source_file=path,
+        cj_id=fields.get("cj_id"),
+        name=name,
+        title=fields.get("title", ""),
+        company=fields.get("company", ""),
+        company_raw=fields.get("company_raw", ""),
+        city=fields.get("city", ""),
+        state=fields.get("state", ""),
+        clearance_level=fields.get("clearance_level", ""),
+        clearances=fields.get("clearances", []),
+        email=fields.get("email", ""),
+        phone=fields.get("phone", ""),
+        linkedin_url=fields.get("linkedin_url", ""),
+        prior_companies=fields.get("prior_companies", []),
+        skills=fields.get("skills", []),
+        program_hint=program_hint,
+        confidence=fields.get("confidence", "C"),
+        needs_review=fields.get("needs_review", True),
+        extra=fields.get("extra", {}),
+    )
+    return rc
