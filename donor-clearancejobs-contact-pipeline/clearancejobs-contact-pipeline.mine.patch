+"""Tests for clearancejobs_pipeline.lanes.resume (deterministic path only).
+
+All fixtures are SYNTHETIC text — no real PII is read from disk.
+Ollama is NOT required; all tests exercise the deterministic extract_fields()
+path only.
+"""
+import pytest
+
+from clearancejobs_pipeline.lanes.resume import extract_fields
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+_SYNTHETIC_FULL = """\
+Jane Doe
+1234 Main Street, Arlington, VA 22201
+Email: jane.doe@example.com
+Phone: 703-555-1234
+LinkedIn: https://www.linkedin.com/in/janedoe
+
+Security Clearance:
+TS/SCI (active)
+
+Professional Experience
+Insight Global                                    Jan 2020 – Present
+Senior Systems Engineer
+
+Skills: Python, Java, AWS, Docker, Kubernetes, Linux
+
+Education
+B.S. Computer Science, George Mason University
+"""
+
+_SYNTHETIC_ANONYMISED = """\
+WORK HISTORY
+Company A   2018-2022
+Lead Software Engineer
+
+DoD Secret clearance required.
+"""
+
+_SYNTHETIC_SECRET_ONLY = """\
+Bob Smith
+bob.smith@corp.com  |  555-867-5309
+https://www.linkedin.com/in/bobsmith
+Dallas, TX
+
+Clearance: Secret
+
+Experience
+Kforce  2021-present
+Software Developer
+"""
+
+
+# ---------------------------------------------------------------------------
+# Tests
+# ---------------------------------------------------------------------------
+
+class TestFullSyntheticResume:
+    """Fixture has name, email, phone, LinkedIn, City/State, TS/SCI, Insight Global."""
+
+    def setup_method(self):
+        self.fields = extract_fields(_SYNTHETIC_FULL, "jane-doe-1234567.pdf")
+
+    def test_email_extracted(self):
+        assert self.fields["email"] == "jane.doe@example.com"
+
+    def test_phone_extracted(self):
+        assert self.fields["phone"] == "703-555-1234"
+
+    def test_linkedin_extracted(self):
+        assert "linkedin.com/in/janedoe" in self.fields["linkedin_url"]
+
+    def test_city_state_extracted(self):
+        assert self.fields["city"] == "Arlington"
+        assert self.fields["state"] == "VA"
+
+    def test_clearance_tssci(self):
+        assert self.fields["clearance_level"] == "TS/SCI"
+        assert "TS/SCI" in self.fields["clearances"]
+
+    def test_company_canonical(self):
+        # "Insight Global" appears in text → should be canonicalised
+        assert self.fields["company"] == "Insight Global"
+
+    def test_confidence_A(self):
+        # email + (phone or linkedin) + company all present
+        assert self.fields["confidence"] == "A"
+
+    def test_needs_review_false(self):
+        assert self.fields["needs_review"] is False
+
+    def test_cj_id_from_filename(self):
+        assert self.fields["cj_id"] == "1234567"
+
+    def test_name_from_filename(self):
+        # filename "jane-doe-1234567.pdf" → slug "jane-doe" → "Jane Doe"
+        assert self.fields["name"] == "Jane Doe"
+
+
+class TestAnonymisedResume:
+    """Filename is anonymous; resume text has no name header."""
+
+    def setup_method(self):
+        self.fields = extract_fields(_SYNTHETIC_ANONYMISED, "anonymous19032-2466200.docx")
+
+    def test_cj_id_is_trailing(self):
+        assert self.fields["cj_id"] == "2466200"
+
+    def test_name_empty_for_anonymous(self):
+        # slug is "anonymous" — should NOT produce a fake name
+        assert self.fields["name"] == ""
+
+    def test_no_email(self):
+        assert self.fields["email"] == ""
+
+    def test_secret_clearance(self):
+        # "DoD Secret" in text but also plain "Secret"
+        assert self.fields["clearance_level"] in ("DoD Secret", "Secret")
+
+    def test_confidence_B_when_no_contact_info(self):
+        assert self.fields["confidence"] == "B"
+
+    def test_needs_review_true(self):
+        assert self.fields["needs_review"] is True
+
+
+class TestSecretClearanceOnly:
+    """Resume mentions only a plain Secret clearance."""
+
+    def setup_method(self):
+        self.fields = extract_fields(_SYNTHETIC_SECRET_ONLY, "bob-smith-9999999.pdf")
+
+    def test_clearance_level_is_secret(self):
+        assert self.fields["clearance_level"] == "Secret"
+
+    def test_clearances_list_contains_secret(self):
+        assert "Secret" in self.fields["clearances"]
+
+    def test_no_tssci(self):
+        assert "TS/SCI" not in self.fields["clearances"]
+
+    def test_email_present(self):
+        assert self.fields["email"] == "bob.smith@corp.com"
+
+    def test_city_state(self):
+        assert self.fields["city"] == "Dallas"
+        assert self.fields["state"] == "TX"
+
+    def test_kforce_canonical(self):
+        assert self.fields["company"] == "Kforce"
+
+    def test_confidence_A_has_email_phone_and_company(self):
+        assert self.fields["confidence"] == "A"
+
+
+class TestClearanceRanking:
+    """When multiple clearance levels appear, the highest should win."""
+
+    def test_tssci_beats_secret(self):
+        text = "Secret clearance. Also holds TS/SCI with polygraph."
+        f = extract_fields(text, "test-1111111.pdf")
+        assert f["clearance_level"] == "TS/SCI w/ Poly"
+
+    def test_tssci_poly_is_highest(self):
+        text = "TS/SCI w/ Poly and previously held a Secret."
+        f = extract_fields(text, "test-2222222.pdf")
+        assert f["clearance_level"] == "TS/SCI w/ Poly"
+        assert len(f["clearances"]) >= 2
+
+    def test_top_secret_beats_secret(self):
+        text = "Active Top Secret. Previous employer required Secret."
+        f = extract_fields(text, "test-3333333.pdf")
+        assert f["clearance_level"] == "Top Secret"
+
+
+class TestNameExtraction:
+    """Name logic: slug preferred unless anonymous."""
+
+    def test_slug_name_used_when_not_anonymous(self):
+        f = extract_fields("some resume text", "john-smith-5556789.pdf")
+        assert f["name"] == "John Smith"
+
+    def test_anonymous_slug_suppressed(self):
+        f = extract_fields("some resume text", "anonymous-2345678.docx")
+        assert f["name"] == ""
+
+    def test_cjresumes_slug_empty_returns_empty_name(self):
+        # clearancejobs.com_resumes_701487_resume.pdf → slug is ""
+        f = extract_fields("some text", "clearancejobs.com_resumes_701487_resume.pdf")
+        assert f["cj_id"] == "701487"
+        assert f["name"] == ""
+
+
+class TestSkillsExtraction:
+    """Skills section is parsed into a list."""
+
+    def test_skills_from_section(self):
+        text = "Skills: Python, Java, AWS, Docker, Kubernetes"
+        f = extract_fields(text, "test-0000001.pdf")
+        assert "Python" in f["skills"]
+        assert "Java" in f["skills"]
+
+    def test_skills_capped_at_20(self):
+        big_skills = ", ".join(f"Skill{i}" for i in range(50))
+        text = f"Technical Skills:\n{big_skills}"
+        f = extract_fields(text, "test-0000002.pdf")
+        assert len(f["skills"]) <= 20
+
+
+class TestNoCrashOnEmptyText:
+    """extract_fields must not crash on empty/whitespace text."""
+
+    def test_empty_text(self):
+        f = extract_fields("", "test-0000003.pdf")
+        assert f["email"] == ""
+        assert f["clearance_level"] == ""
+        assert f["confidence"] == "B"
+
+    def test_whitespace_only(self):
+        f = extract_fields("   \n  \t  ", "test-0000004.pdf")
+        assert isinstance(f, dict)
