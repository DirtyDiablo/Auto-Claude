+    return [k for k in CONTACT_KEYS if k not in contact]
diff --git a/clearancejobs_pipeline/spine/match_programs.py b/clearancejobs_pipeline/spine/match_programs.py
new file mode 100644
index 000000000..5d0c85f1a
--- /dev/null
+++ b/clearancejobs_pipeline/spine/match_programs.py
@@ -0,0 +1,131 @@
+"""Stage C — score each contact against the target programs.
+
+Inverse of build_contacts.py: we HAVE the people, match them TO programs using the same
+dimensions (company / PoP-location / title-skills / clearance) reversed. Config basis =
+outputs/booz_target_ranking/contacts/_contract_config.json (prime, competitor_subs,
+clearance, pop_cities, role_families, title_keywords).
+
+A contact matches a program only when composite >= THRESHOLD AND there is a real BD reason
+(employer is the prime/a competitor sub, OR PoP-city + title both hit, OR the contact was
+sourced under that program). This prevents 'cleared person in DC' from matching every DC
+program.
+"""
+from __future__ import annotations
+
+import json
+import re
+
+from ..lib.companies import company_in
+from ..lib.geo import city_key, config_city_keys
+
+DEFAULT_CONFIG = "outputs/booz_target_ranking/contacts/_contract_config.json"
+
+WEIGHTS = {"company": 35, "location": 30, "title": 20, "clearance": 15}
+# program_hint = the candidate was curated under this program's own CJ search (strong prior).
+# Sized so hint + clearance alone clears THRESHOLD, keeping pre-qualified leads on the sheet.
+HINT_BONUS = 35
+THRESHOLD = 45
+
+_CLEAR_RANK = [
+    (re.compile(r"sci.*poly|ts/sci.*poly|poly", re.I), 5),
+    (re.compile(r"ts/sci", re.I), 4),
+    (re.compile(r"top secret|\bts\b", re.I), 3),
+    (re.compile(r"secret", re.I), 2),
+    (re.compile(r"public trust", re.I), 1),
+]
+
+
+def clearance_rank(s: str) -> int:
+    s = s or ""
+    best = 0
+    for pat, r in _CLEAR_RANK:
+        if pat.search(s):
+            best = max(best, r)
+    return best
+
+
+def load_config(path: str = DEFAULT_CONFIG) -> dict:
+    return json.load(open(path, encoding="utf-8"))["contracts"]
+
+
+def _title_re(title_keywords: list[str]):
+    return re.compile("|".join(re.escape(k) for k in title_keywords), re.I) if title_keywords else None
+
+
+def score_contact_program(contact: dict, piid: str, prog: dict) -> tuple[float, dict, bool, bool, bool]:
+    bd: dict = {}
+    sm = contact.get("source_metadata") or {}
+
+    # --- company (recruit-from prime or competitor sub) ---
+    wanted = [prog.get("prime", "")] + list(prog.get("competitor_subs", []))
+    comp_blob = " ".join(str(contact.get(f) or "") for f in ["company", "company_name"])
+    comp_blob += " " + " ".join(sm.get("prior_companies", []) or [])
+    hit_company = company_in(comp_blob, [w for w in wanted if w])
+    bd["company"] = WEIGHTS["company"] if hit_company else 0
+
+    # --- location (PoP city is load-bearing; relo widens partially) ---
+    ckeys = config_city_keys(prog.get("pop_cities", []))
+    ck = city_key(contact.get("city") or "", contact.get("state") or "")
+    loc_hit = bool(contact.get("city")) and ck in ckeys
+    if loc_hit:
+        bd["location"] = WEIGHTS["location"]
+    elif sm.get("relo"):
+        bd["location"] = round(WEIGHTS["location"] * 0.4, 1)
+    else:
+        bd["location"] = 0
+
+    # --- title / skills vs role families ---
+    tre = _title_re(prog.get("title_keywords", []))
+    title = contact.get("title") or ""
+    skills = " ".join(sm.get("skills", []) or [])
+    title_hit = bool(tre and (tre.search(title) or tre.search(skills)))
+    bd["title"] = WEIGHTS["title"] if title_hit else 0
+
+    # --- clearance ---
+    creq = clearance_rank(prog.get("clearance", ""))
+    chave = clearance_rank(contact.get("clearance_level") or " ".join(contact.get("clearances") or []))
+    if creq == 0:
+        bd["clearance"] = WEIGHTS["clearance"]
+    elif chave >= creq:
+        bd["clearance"] = WEIGHTS["clearance"]
+    elif chave > 0:
+        bd["clearance"] = round(WEIGHTS["clearance"] * 0.5, 1)
+    else:
+        bd["clearance"] = 0
+
+    # --- sourced-under-this-program prior ---
+    if sm.get("program_hint") == piid:
+        bd["program_hint"] = HINT_BONUS
+
+    composite = float(sum(bd.values()))
+    return composite, bd, hit_company, loc_hit, title_hit
+
+
+def match_all(contacts: list[dict], config: dict | None = None) -> list[dict]:
+    cfg = config if config is not None else load_config()
+    for contact in contacts:
+        best = None
+        matched: list[str] = []
+        primes: set[str] = set()
+        for piid, prog in cfg.items():
+            comp, bd, hit_company, loc_hit, title_hit = score_contact_program(contact, piid, prog)
+            has_reason = hit_company or (loc_hit and title_hit) or ("program_hint" in bd)
+            if comp >= THRESHOLD and has_reason:
+                matched.append(piid)
+                if prog.get("prime"):
+                    primes.add(prog["prime"])
+                if best is None or comp > best[1]:
+                    best = (piid, comp, bd)
+        contact["programs"] = matched
+        contact["primes"] = sorted(primes)
+        if best:
+            contact["composite_score"] = round(best[1], 1)
+            sb = dict(best[2])
+            sb["_best_piid"] = best[0]
+            contact["score_breakdown"] = sb
+            contact["raw_relevance_score"] = round(best[1], 1)
+        else:
+            contact["composite_score"] = 0.0
+            contact["score_breakdown"] = {}
+            contact["raw_relevance_score"] = 0.0
+    return contacts
diff --git a/clearancejobs_pipeline/spine/resolve.py b/clearancejobs_pipeline/spine/resolve.py
new file mode 100644
index 000000000..3041e1969
--- /dev/null
+++ b/clearancejobs_pipeline/spine/resolve.py
@@ -0,0 +1,130 @@
+"""Stage B — entity resolution / dedup.
+
+1. Within-intake dedup by `_local_key` (cj_id -> name+location). Resume beats paste on
+   field conflicts; paste's hot/last-login signal is preserved; sources are unioned.
+2. flag_against_existing: collision vs the existing 7,339-contact CRM
+   (data/dashboard/contacts_classified.json, read-only) by email / linkedin / normalized
+   name -> set needs_review + merge_candidate_ids. Never overwrites existing data.
+"""
+from __future__ import annotations
+
+import json
+import re
+
+EXISTING_DEFAULT = "data/dashboard/contacts_classified.json"
+
+_SCALAR_SKIP = {
+    "sources", "source_provenance", "source_metadata", "clearances", "programs",
+    "primes", "inferred_locations", "score_breakdown", "_local_key",
+    "needs_review", "tier", "composite_score", "raw_relevance_score", "note_count",
+    "authors", "pain_points",
+}
+
+
+def _empty(v) -> bool:
+    return v is None or v == "" or v == [] or v == {}
+
+
+def _is_resume(c: dict) -> bool:
+    return "ClearanceJobs resume" in (c.get("sources") or [])
+
+
+def _norm_name(rec: dict) -> str:
+    full = f"{rec.get('first_name') or ''} {rec.get('last_name') or ''}".strip()
+    if not full:
+        full = rec.get("name") or ""
+    return re.sub(r"[^a-z]", "", full.lower())
+
+
+def _norm_li(url) -> str:
+    if not url:
+        return ""
+    m = re.search(r"linkedin\.com/in/([\w\-%]+)", str(url), re.I)
+    return m.group(1).lower() if m else ""
+
+
+def _merge_into(base: dict, other: dict) -> None:
+    for k, v in other.items():
+        if k in _SCALAR_SKIP:
+            continue
+        if _empty(base.get(k)) and not _empty(v):
+            base[k] = v
+    base["sources"] = sorted(set((base.get("sources") or []) + (other.get("sources") or [])))
+    base["clearances"] = sorted({x for x in (base.get("clearances") or []) + (other.get("clearances") or []) if x})
+    base["inferred_locations"] = sorted({x for x in (base.get("inferred_locations") or []) + (other.get("inferred_locations") or []) if x})
+    sp = dict(other.get("source_provenance") or {})
+    sp.update(base.get("source_provenance") or {})
+    base["source_provenance"] = sp
+    bm = dict(base.get("source_metadata") or {})
+    om = dict(other.get("source_metadata") or {})
+    merged = {**om, **{k: v for k, v in bm.items() if not _empty(v) and v is not False}}
+    merged["cj_last_login_hot"] = bool(bm.get("cj_last_login_hot") or om.get("cj_last_login_hot"))
+    merged["cj_last_login"] = bm.get("cj_last_login") or om.get("cj_last_login") or ""
+    merged["cj_id"] = bm.get("cj_id") or om.get("cj_id")
+    base["source_metadata"] = merged
+    # keep the richer (resume) needs_review when resume is base; else OR
+    if not _is_resume(base):
+        base["needs_review"] = bool(base.get("needs_review") or other.get("needs_review"))
+
+
+def dedupe(contacts: list[dict]) -> list[dict]:
+    groups: dict[str, list[dict]] = {}
+    order: list[str] = []
+    for c in contacts:
+        k = c.get("_local_key")
+        if k not in groups:
+            groups[k] = []
+            order.append(k)
+        groups[k].append(c)
+    out = []
+    for k in order:
+        grp = groups[k]
+        if len(grp) == 1:
+            out.append(grp[0])
+            continue
+        base = next((c for c in grp if _is_resume(c)), grp[0])
+        for other in grp:
+            if other is base:
+                continue
+            _merge_into(base, other)
+        out.append(base)
+    return out
+
+
+def flag_against_existing(contacts: list[dict], existing_path: str = EXISTING_DEFAULT) -> list[dict]:
+    try:
+        data = json.load(open(existing_path, encoding="utf-8"))
+    except Exception:
+        for c in contacts:
+            c.setdefault("source_metadata", {})["existing_check"] = "unavailable"
+        return contacts
+    existing = data.get("contacts", data) if isinstance(data, dict) else data
+    by_email: dict[str, list] = {}
+    by_name: dict[str, list] = {}
+    by_li: dict[str, list] = {}
+    for e in existing:
+        eid = e.get("id")
+        em = (e.get("email") or "").strip().lower()
+        if em:
+            by_email.setdefault(em, []).append(eid)
+        nm = _norm_name(e)
+        if nm:
+            by_name.setdefault(nm, []).append(eid)
+        li = _norm_li(e.get("linkedin"))
+        if li:
+            by_li.setdefault(li, []).append(eid)
+    for c in contacts:
+        hits = set()
+        em = (c.get("email") or "").strip().lower()
+        if em and em in by_email:
+            hits.update(by_email[em])
+        li = _norm_li(c.get("linkedin_url"))
+        if li and li in by_li:
+            hits.update(by_li[li])
+        nm = _norm_name(c)
+        if nm and nm in by_name:
+            hits.update(by_name[nm])
+        if hits:
+            c["needs_review"] = True
+            c.setdefault("source_metadata", {})["merge_candidate_ids"] = [h for h in sorted(map(str, hits))][:5]
+    return contacts
