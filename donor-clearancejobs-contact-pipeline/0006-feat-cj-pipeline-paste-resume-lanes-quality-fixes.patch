+"""Tests for clearancejobs_pipeline.lanes.paste.
+
+All fixtures are SYNTHETIC — no real PII files are read.
+"""
+from __future__ import annotations
+
+import textwrap
+
+import pytest
+
+from clearancejobs_pipeline.lanes.paste import parse_paste_text
+
+
+# ---------------------------------------------------------------------------
+# Synthetic fixture text
+# ---------------------------------------------------------------------------
+
+# A realistic-looking paste with 4 synthetic candidates:
+#   1. Alice Norwood — relo + salary, terminated by lone initial
+#   2. Bob Carver    — no relo/salary, terminated by lone initial
+#   3. Carol Brandt  — second date line present (should be ignored for cj_last_login), user-avatar terminator
+#   4. Dan Halloway  — Insight Global in thumbnail (employer canonicalization test), user-avatar terminator
+SYNTHETIC_PASTE = textwrap.dedent("""\
+    Viewing 1 - 50 of 200
+    Candidates
+    Show:
+    50 per page
+    Sort by:
+    Last Login Date (Des)
+    Alice Norwood
+    Systems Security Engineer
+    Arlington, VA
+    Today
+    TS/SCI
+    10+ yrs exp
+    Yes - Open to relo
+    $175,000
+    Experienced ISSO supporting RMF and NIST SP 800-53 controls
+    A
+    Bob Carver
+    Cybersecurity Analyst
+    San Diego, CA
+    Yesterday
+    Secret
+    5+ yrs exp
+    Worked on DISA STIG compliance and vulnerability management
+    B
+    Carol Brandt
+    Software Security Engineer
+    Herndon, VA
+    Today
+    TS/SCI w Poly
+    Mgr/Director
+    May 15
+    No - Not open to relo
+    $220,000
+    Provided cyber engineering support at NSA for 12 years
+    user avatar
+    Dan Halloway
+    Network Engineer
+    Chantilly, VA
+    May 20
+    TS/SCI
+    10+ yrs exp
+    Yes - Open to relo
+    INSIGHT GLOBAL, LLC - Senior Network Admin supporting DHS programs
+    Configured enterprise routers and switches
+    user avatar
+""")
+
+# Paste without any header section
+HEADERLESS_PASTE = textwrap.dedent("""\
+    Jane Smith
+    Senior ISSO
+    Bethesda, MD
+    Today
+    TS/SCI
+    10+ yrs exp
+    No - Not open to relo
+    $200,000
+    Supporting RMF across multiple DoD programs
+    J
+""")
+
+
+# ---------------------------------------------------------------------------
+# Tests
+# ---------------------------------------------------------------------------
+
+class TestSyntheticPaste:
+    """Multi-block fixture: correctness tests."""
+
+    def _contacts(self):
+        return parse_paste_text(SYNTHETIC_PASTE, source_file="test_synthetic.txt",
+                                program_hint="TEST-PIID-001")
+
+    def test_count(self):
+        contacts = self._contacts()
+        assert len(contacts) == 4, f"Expected 4 contacts, got {len(contacts)}"
+
+    def test_alice_norwood(self):
+        c = self._contacts()[0]
+        assert c.name == "Alice Norwood"
+        assert c.title == "Systems Security Engineer"
+        assert c.city == "Arlington"
+        assert c.state == "VA"
+        assert c.clearance_level.startswith("TS/SCI")
+        assert c.cj_last_login == "Today"
+        assert c.cj_last_login_hot is True
+        assert c.relo is True
+        assert c.salary_expectation == "$175,000"
+        assert c.seniority_band == "10+ yrs exp"
+
+    def test_bob_carver_no_relo_no_salary(self):
+        c = self._contacts()[1]
+        assert c.name == "Bob Carver"
+        assert c.city == "San Diego"
+        assert c.state == "CA"
+        assert c.clearance_level.lower().startswith("secret") or "Secret" in c.clearance_level
+        assert c.relo is None      # no relo line
+        assert c.salary_expectation == ""
+        assert c.cj_last_login == "Yesterday"
+        assert c.cj_last_login_hot is False
+
+    def test_carol_brandt_second_date_ignored(self):
+        """May 15 is a second date line; cj_last_login must be 'Today', not 'May 15'."""
+        c = self._contacts()[2]
+        assert c.name == "Carol Brandt"
+        assert c.cj_last_login == "Today"
+        assert c.cj_last_login_hot is True
+        assert c.relo is False
+        assert c.salary_expectation == "$220,000"
+        assert c.seniority_band in ("Mgr/Director",)
+
+    def test_dan_halloway_company_canonicalized(self):
+        """Insight Global in thumbnail → company canonicalized to 'Insight Global'."""
+        c = self._contacts()[3]
+        assert c.name == "Dan Halloway"
+        assert c.company == "Insight Global"
+        assert "INSIGHT GLOBAL" in c.company_raw.upper()
+
+    def test_lane_source_program_hint(self):
+        for c in self._contacts():
+            assert c.lane == "paste"
+            assert c.source_file == "test_synthetic.txt"
+            assert c.program_hint == "TEST-PIID-001"
+            assert c.confidence == "C"
+            assert c.needs_review is True
+
+    def test_clearances_list_populated(self):
+        """clearances list should contain at least one entry per contact."""
+        contacts = self._contacts()
+        for c in contacts:
+            assert len(c.clearances) >= 1, f"{c.name}: clearances list is empty"
+
+
+class TestHeaderlessAndEdgeCases:
+    """Edge-case robustness tests."""
+
+    def test_headerless_paste_parses(self):
+        contacts = parse_paste_text(HEADERLESS_PASTE, source_file="headerless.txt")
+        assert len(contacts) == 1
+        c = contacts[0]
+        assert c.name == "Jane Smith"
+        assert c.city == "Bethesda"
+        assert c.state == "MD"
+
+    def test_empty_string_returns_empty(self):
+        assert parse_paste_text("") == []
+
+    def test_whitespace_only_returns_empty(self):
+        assert parse_paste_text("   \n\n   ") == []
+
+    def test_garbage_string_does_not_raise(self):
+        """Garbage input must not raise; parsed count is implementation-defined."""
+        result = parse_paste_text("%%% NOT A VALID PASTE %%%\n????\n====")
+        assert isinstance(result, list)  # no crash, returns a list
+
+    def test_single_candidate_no_terminator(self):
+        """A block with no terminator at EOF is still returned."""
+        text = textwrap.dedent("""\
+            Viewing 1 - 1 of 1
+            Candidates
+            Show:
+            1 per page
+            Sort by:
+            Last Login Date (Des)
+            Solo Candidate
+            Junior Analyst
+            Reston, VA
+            Today
+            Secret
+            Entry Level
+        """)
+        contacts = parse_paste_text(text)
+        assert len(contacts) == 1
+        assert contacts[0].name == "Solo Candidate"
+
+
+class TestUserAvatarVsInitialTerminator:
+    """Terminator style coverage."""
+
+    def test_user_avatar_terminator(self):
+        text = textwrap.dedent("""\
+            Sort by:
+            Last Login Date (Des)
+            Eric Vance
+            Security Architect
+            Tampa, FL
+            Today
+            TS/SCI
+            10+ yrs exp
+            user avatar
+            Frank Jones
+            Systems Engineer
+            Reston, VA
+            Yesterday
+            Secret
+            5+ yrs exp
+            F
+        """)
+        contacts = parse_paste_text(text)
+        assert len(contacts) == 2
+        assert contacts[0].name == "Eric Vance"
+        assert contacts[1].name == "Frank Jones"
+
+    def test_mixed_terminators(self):
+        """Some blocks use lone-initial, some use user avatar — both work."""
+        text = textwrap.dedent("""\
+            Sort by:
+            Date (Desc)
+            Alpha User
+            ISSO
+            McLean, VA
+            Today
+            TS/SCI
+            10+ yrs exp
+            A
+            Beta User
+            Pen Tester
+            Denver, CO
+            Yesterday
+            Secret
+            5+ yrs exp
+            user avatar
+        """)
+        contacts = parse_paste_text(text)
+        assert len(contacts) == 2
+        names = [c.name for c in contacts]
+        assert "Alpha User" in names
+        assert "Beta User" in names
