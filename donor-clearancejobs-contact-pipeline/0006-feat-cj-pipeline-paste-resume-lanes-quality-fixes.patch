+Ollama is NOT required; all tests exercise the deterministic extract_fields()
+path only.
+"""
+import pytest
+
+from clearancejobs_pipeline.lanes.resume import extract_fields
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
