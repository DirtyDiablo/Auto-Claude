+from clearancejobs_pipeline.models import RawContact, build_contact
+from clearancejobs_pipeline.spine.resolve import dedupe
+
+
+def test_resume_wins_over_paste_same_cjid():
+    paste = build_contact(RawContact(
+        lane="paste", source_file="p.txt", cj_id="2032428", name="Jalen Pestillo",
+        title="Engineer", cj_last_login="Today", cj_last_login_hot=True))
+    resume = build_contact(RawContact(
+        lane="resume", source_file="r.pdf", cj_id="2032428", name="Jalen Pestillo",
+        title="Senior Cyber Engineer", email="j@example.com", confidence="A",
+        needs_review=False))
+    merged = dedupe([paste, resume])
+    assert len(merged) == 1
+    m = merged[0]
+    assert m["email"] == "j@example.com"                      # resume field won
+    assert m["title"] == "Senior Cyber Engineer"
+    assert m["source_metadata"]["cj_last_login_hot"] is True  # paste signal preserved
+    assert set(m["sources"]) == {"ClearanceJobs paste", "ClearanceJobs resume"}
+
+
+def test_distinct_contacts_not_merged():
+    a = build_contact(RawContact(lane="paste", source_file="p", name="Alice Adams", city="Reston", state="VA"))
+    b = build_contact(RawContact(lane="paste", source_file="p", name="Carl Dean", city="Reston", state="VA"))
+    assert len(dedupe([a, b])) == 2
+
+
+def test_name_location_key_merges_without_cjid():
+    a = build_contact(RawContact(lane="paste", source_file="p", name="Sam Vale", city="Austin", state="TX"))
+    b = build_contact(RawContact(lane="resume", source_file="r", name="Sam Vale", city="Austin", state="TX", email="s@x.com"))
+    merged = dedupe([a, b])
+    assert len(merged) == 1
+    assert merged[0]["email"] == "s@x.com"
