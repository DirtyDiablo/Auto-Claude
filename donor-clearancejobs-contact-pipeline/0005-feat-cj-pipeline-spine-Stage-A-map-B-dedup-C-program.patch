+from clearancejobs_pipeline.models import RawContact, build_contact
+from clearancejobs_pipeline.spine.match_programs import match_all
+
+CONFIG = {
+    "50310220F0017": {
+        "program": "SEC IT Testing & Compliance", "agency": "SEC",
+        "prime": "Booz Allen Hamilton",
+        "competitor_subs": ["Take2", "Insight Global", "Kforce"],
+        "clearance": "Public Trust / Secret",
+        "pop_cities": ["Washington, D.C., District of Columbia", "Arlington, Virginia",
+                       "Alexandria, Virginia"],
+        "role_families": ["ISSO"],
+        "title_keywords": ["ISSO", "Security Assessor", "RMF", "Compliance"],
+    }
+}
+
+
+def test_competitor_sub_in_pop_with_title_matches():
+    c = build_contact(RawContact(
+        lane="paste", source_file="x", name="Jane Doe", title="ISSO",
+        city="Arlington", state="VA", clearance_level="Secret", company="Insight Global"))
+    match_all([c], CONFIG)
+    assert "50310220F0017" in c["programs"]
+    assert c["composite_score"] >= 45
+    assert "Booz Allen Hamilton" in c["primes"]
+    assert c["score_breakdown"]["company"] == 35
+
+
+def test_program_hint_alone_qualifies():
+    c = build_contact(RawContact(
+        lane="paste", source_file="x", name="Hot Lead", title="Systems Administrator",
+        city="Dayton", state="MD", clearance_level="TS/SCI",
+        program_hint="50310220F0017"))
+    match_all([c], CONFIG)
+    assert "50310220F0017" in c["programs"]
+
+
+def test_irrelevant_contact_no_match():
+    c = build_contact(RawContact(
+        lane="paste", source_file="x", name="Bob Smith", title="Line Cook",
+        city="Miami", state="FL", clearance_level=""))
+    match_all([c], CONFIG)
+    assert c["programs"] == []
+    assert c["composite_score"] == 0.0
