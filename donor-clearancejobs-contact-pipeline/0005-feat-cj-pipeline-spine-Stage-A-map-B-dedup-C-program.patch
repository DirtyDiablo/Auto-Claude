@@ -0,0 +1,113 @@
+"""Orchestrate Stage 0 -> D.
+
+  python3 -m clearancejobs_pipeline.run                 # deterministic (default, fast)
+  python3 -m clearancejobs_pipeline.run --ollama        # + local Ollama resume enrichment
+  python3 -m clearancejobs_pipeline.run --skip-intake   # reuse already-copied intake/
+  python3 -m clearancejobs_pipeline.run --config <path> --out <dir>   # reuse for another prime
+
+Writes canonical per-contact JSON to intake/clearancejobs/contacts/ (gitignored) and
+per-program call sheets to --out (gitignored). A run report lands at
+intake/clearancejobs/_run_report.json.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from datetime import datetime, timezone
+
+from .intake import INTAKE_ROOT, REPO, run_intake
+from .spine.call_sheet import write_call_sheets
+from .spine.map_contact import map_contacts
+from .spine.match_programs import DEFAULT_CONFIG, load_config, match_all
+from .spine.resolve import dedupe, flag_against_existing
+
+
+def _collect_raws(manifest: list, use_ollama: bool):
+    from .lanes.paste import parse_paste
+    from .lanes.resume import parse_resume
+
+    raws = []
+    errors = []
+    for m in manifest:
+        if m.get("status") == "missing":
+            continue
+        dest = os.path.join(REPO, m["dest"])
+        lane = m.get("lane")
+        hint = m.get("program_hint")
+        try:
+            if lane == "paste":
+                raws.extend(parse_paste(dest, program_hint=hint) or [])
+            else:
+                rc = parse_resume(dest, program_hint=hint, use_ollama=use_ollama)
+                if rc:
+                    raws.append(rc)
+        except Exception as e:  # per-file isolation — never abort the batch
+            errors.append({"file": m.get("name"), "lane": lane, "error": repr(e)})
+    return raws, errors
+
+
+def run_pipeline(use_ollama=False, config_path=DEFAULT_CONFIG,
+                 out_dir=None, skip_intake=False, existing_check=True):
+    out_dir = out_dir or os.path.join(REPO, "outputs", "booz_target_ranking", "humint")
+    if not skip_intake:
+        run_intake()
+    manifest = json.load(open(os.path.join(INTAKE_ROOT, "_manifest.json"), encoding="utf-8"))["files"]
+
+    raws, errors = _collect_raws(manifest, use_ollama)
+    contacts = map_contacts(raws)
+    contacts = dedupe(contacts)
+    if existing_check:
+        contacts = flag_against_existing(contacts)
+    cfg = load_config(config_path)
+    contacts = match_all(contacts, cfg)
+
+    cdir = os.path.join(INTAKE_ROOT, "contacts")
+    os.makedirs(cdir, exist_ok=True)
+    for c in contacts:
+        key = (c.get("_local_key") or "unknown").replace(":", "_").replace("|", "_").replace("/", "_")
+        with open(os.path.join(cdir, f"{key}.json"), "w", encoding="utf-8") as fh:
+            json.dump(c, fh, indent=2, ensure_ascii=False)
+
+    paths = write_call_sheets(contacts, cfg, out_dir)
+
+    report = {
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "n_raw": len(raws),
+        "n_contacts": len(contacts),
+        "n_matched": sum(1 for c in contacts if c.get("programs")),
+        "n_hot": sum(1 for c in contacts if (c.get("source_metadata") or {}).get("cj_last_login_hot")),
+        "ollama": use_ollama,
+        "errors": errors,
+        "call_sheets": [os.path.relpath(p, REPO).replace("\\", "/") for p in paths],
+    }
+    with open(os.path.join(INTAKE_ROOT, "_run_report.json"), "w", encoding="utf-8") as fh:
+        json.dump(report, fh, indent=2)
+    return report
+
+
+def main():
+    ap = argparse.ArgumentParser(description="ClearanceJobs -> Contact -> call sheets")
+    ap.add_argument("--ollama", action="store_true", help="enable local Ollama resume enrichment")
+    ap.add_argument("--config", default=DEFAULT_CONFIG)
+    ap.add_argument("--out", default=None)
+    ap.add_argument("--skip-intake", action="store_true")
+    ap.add_argument("--no-existing-check", action="store_true")
+    args = ap.parse_args()
+
+    rep = run_pipeline(
+        use_ollama=args.ollama,
+        config_path=args.config,
+        out_dir=args.out,
+        skip_intake=args.skip_intake,
+        existing_check=not args.no_existing_check,
+    )
+    print(f"raws={rep['n_raw']} contacts={rep['n_contacts']} matched={rep['n_matched']} "
+          f"hot={rep['n_hot']} errors={len(rep['errors'])}")
+    for e in rep["errors"][:10]:
+        print("  ERR", e)
+    print("call sheets:", len(rep["call_sheets"]))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/clearancejobs_pipeline/spine/call_sheet.py b/clearancejobs_pipeline/spine/call_sheet.py
new file mode 100644
index 000000000..ae770aa89
--- /dev/null
+++ b/clearancejobs_pipeline/spine/call_sheet.py
@@ -0,0 +1,134 @@
+"""Stage D — per-program HUMINT call sheets (Markdown + CSV) + HUMINT_SUMMARY.md.
+
+Output dir defaults to outputs/booz_target_ranking/humint/ which is GITIGNORED (PII).
+A contact appears on every program it matched (recruiters for each program want them).
+"""
+from __future__ import annotations
+
+import csv
+import io
+import os
+from collections import defaultdict
+from datetime import datetime, timezone
+
+from .match_programs import load_config
+
+CSV_COLS = ["rank", "name", "title", "company", "tier", "composite_score",
+            "clearance_level", "city", "state", "relo", "hot", "cj_id",
+            "sources", "needs_review", "programs"]
+
+
+def _row(c: dict, rank: int) -> dict:
+    sm = c.get("source_metadata") or {}
+    return {
+        "rank": rank,
+        "name": c.get("name") or "",
+        "title": c.get("title") or "",
+        "company": c.get("company") or "",
+        "tier": c.get("tier") if c.get("tier") is not None else "",
+        "composite_score": c.get("composite_score") if c.get("composite_score") is not None else "",
+        "clearance_level": c.get("clearance_level") or "",
+        "city": c.get("city") or "",
+        "state": c.get("state") or "",
+        "relo": "Yes" if sm.get("relo") else ("No" if sm.get("relo") is False else ""),
+        "hot": "HOT" if sm.get("cj_last_login_hot") else "",
+        "cj_id": sm.get("cj_id") or "",
+        "sources": "; ".join(c.get("sources") or []),
+        "needs_review": c.get("needs_review"),
+        "programs": "; ".join(c.get("programs") or []),
+    }
+
+
+def _render_csv(rows: list[dict]) -> str:
+    buf = io.StringIO()
+    w = csv.DictWriter(buf, fieldnames=CSV_COLS)
+    w.writeheader()
+    for i, c in enumerate(rows, 1):
+        w.writerow(_row(c, i))
+    return buf.getvalue()
+
+
+def _render_md(piid: str, prog: dict, rows: list[dict]) -> str:
+    subs = ", ".join(prog.get("competitor_subs", [])) or "-"
+    pop = ", ".join(prog.get("pop_cities", [])) or "-"
+    hot_n = sum(1 for c in rows if (c.get("source_metadata") or {}).get("cj_last_login_hot"))
+    out = []
+    out.append(f"# HUMINT Call Sheet — {prog.get('program','?')} (`{piid}`)\n")
+    out.append(f"- **Prime:** {prog.get('prime','?')}  ·  **Agency:** {prog.get('agency','?')}")
+    out.append(f"- **Value:** ${prog.get('value_$M','?')}M  ·  **PoP end:** {prog.get('pop_end','?')}")
+    out.append(f"- **Recruit-from competitor subs:** {subs}")
+    out.append(f"- **Clearance:** {prog.get('clearance','?')}")
+    out.append(f"- **PoP metros:** {pop}")
+    out.append(f"- **Candidates:** {len(rows)}  ·  **🔥 hot (logged in today):** {hot_n}\n")
+    out.append("| # | Name | Title | Company | Tier | Score | Clearance | Location | Relo | Hot | CJ id | Source | Review |")
+    out.append("|---|------|-------|---------|------|-------|-----------|----------|------|-----|-------|--------|--------|")
+    for i, c in enumerate(rows, 1):
+        r = _row(c, i)
+        loc = f"{r['city']}, {r['state']}".strip(", ")
+        src = "resume" if "ClearanceJobs resume" in (c.get("sources") or []) else "paste"
+        review = "⚠" if c.get("needs_review") else ""
+        out.append(f"| {i} | {r['name']} | {r['title']} | {r['company']} | {r['tier']} | "
+                   f"{r['composite_score']} | {r['clearance_level']} | {loc} | {r['relo']} | "
+                   f"{'🔥' if r['hot'] else ''} | {r['cj_id']} | {src} | {review} |")
+    out.append("\n> ⚠ = needs review (paste-lane stub or collides with an existing CRM contact). "
+               "🔥 = last ClearanceJobs login was today.\n")
+    return "\n".join(out)
+
+
+def _render_summary(cfg: dict, by_piid: dict, unmatched: list, contacts: list) -> str:
+    hot_total = sum(1 for c in contacts if (c.get("source_metadata") or {}).get("cj_last_login_hot"))
+    out = []
+    out.append("# HUMINT Pipeline Summary\n")
+    out.append(f"- Generated: {datetime.now(timezone.utc).isoformat()}")
+    out.append(f"- Total resolved contacts: **{len(contacts)}**")
+    out.append(f"- Matched to >=1 program: **{sum(1 for c in contacts if c.get('programs'))}**")
+    out.append(f"- Unmatched: **{len(unmatched)}**")
+    out.append(f"- 🔥 Hot (logged in today): **{hot_total}**\n")
+    out.append("| Program | PIID | Candidates | Hot | Top score |")
+    out.append("|---------|------|-----------|-----|-----------|")
+    for piid, prog in cfg.items():
+        rows = by_piid.get(piid, [])
+        if not rows:
+            continue
+        hot = sum(1 for c in rows if (c.get("source_metadata") or {}).get("cj_last_login_hot"))
+        top = max((c.get("composite_score") or 0) for c in rows)
+        out.append(f"| {prog.get('program','?')} | `{piid}` | {len(rows)} | {hot} | {top} |")
+    if unmatched:
+        out.append(f"\n## Unmatched ({len(unmatched)})\n")
+        out.append("Persisted with `programs=[]` — review for off-program relevance.\n")
+        for c in unmatched[:50]:
+            loc = f"{c.get('city') or ''}, {c.get('state') or ''}".strip(", ")
+            out.append(f"- {c.get('name')} — {c.get('title') or '?'} — {c.get('company') or '?'} — {loc}")
+    return "\n".join(out)
+
+
+def write_call_sheets(contacts: list[dict], config: dict | None = None,
+                      out_dir: str = "outputs/booz_target_ranking/humint") -> list[str]:
+    cfg = config if config is not None else load_config()
+    os.makedirs(out_dir, exist_ok=True)
+    by_piid: dict[str, list] = defaultdict(list)
+    unmatched: list = []
+    for c in contacts:
+        if c.get("programs"):
+            for piid in c["programs"]:
+                by_piid[piid].append(c)
+        else:
+            unmatched.append(c)
+    written: list[str] = []
+    for piid, prog in cfg.items():
+        rows = by_piid.get(piid, [])
+        if not rows:
+            continue
+        rows = sorted(rows, key=lambda c: (-(c.get("composite_score") or 0), c.get("tier") or 6))
+        mp = os.path.join(out_dir, f"{piid}_callsheet.md")
+        cp = os.path.join(out_dir, f"{piid}_callsheet.csv")
+        with open(mp, "w", encoding="utf-8") as fh:
+            fh.write(_render_md(piid, prog, rows))
+        with open(cp, "w", newline="", encoding="utf-8-sig") as fh:
+            fh.write(_render_csv(rows))
+        written += [mp, cp]
+    sp = os.path.join(out_dir, "HUMINT_SUMMARY.md")
+    with open(sp, "w", encoding="utf-8") as fh:
+        fh.write(_render_summary(cfg, by_piid, unmatched, contacts))
+    written.append(sp)
+    return written
