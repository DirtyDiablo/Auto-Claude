+"""6-tier BD contact classification by job title.
+
+Provenance: bd-contact-classification skill / build_contacts.py TIER_PATTERNS.
+Tier 1 = decision makers ... Tier 6 = general network.
+"""
+from __future__ import annotations
+
+import re
+
+TIER_PATTERNS = [
+    (1, re.compile(r"(CEO|CTO|CFO|CIO|\bVP\b|Vice President|President|Director|Partner|Managing|Principal|Chief|Head of)", re.I)),
+    (2, re.compile(r"(Architect|Senior Engineer|Principal Engineer|Fellow|Lead Engineer|Tech Lead|Staff Engineer)", re.I)),
+    (3, re.compile(r"(Program Manager|Project Manager|\bPMO\b|\bCOR\b|\bGTL\b|COTR|Contracting Officer|Capture|Scrum Master|Product Owner)", re.I)),
+    (4, re.compile(r"(Speaker|Board|Chair|Advisory|Former|Retired|Liaison|Small Business)", re.I)),
+    (5, re.compile(r"(Analyst|Consultant|Advisor|Research|Journalist)", re.I)),
+]
+
+
+def tier_for(title: str) -> int:
+    """Return BD tier 1-6 for a job title (6 = no pattern matched)."""
+    t = title or ""
+    for tier, pat in TIER_PATTERNS:
+        if pat.search(t):
+            return tier
+    return 6
