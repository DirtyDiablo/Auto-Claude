+"""ClearanceJobs -> Contact entity pipeline.
+
+Two-lane local pipeline that turns downloaded ClearanceJobs result-list pastes and
+resumes into canonical Contact-entity profiles, matches them to target programs, and
+emits per-program HUMINT call sheets.
+
+Spec: docs/superpowers/specs/2026-06-02-clearancejobs-contact-pipeline-design.md
+Plan: docs/superpowers/plans/2026-06-02-clearancejobs-contact-pipeline.md
+
+PRIVACY: cleared-personnel PII. `intake/` and `outputs/.../humint/` are gitignored.
+Only `intake.py` ever touches a Downloads path (allow-list copy). Extraction is 100% local.
+"""
+__all__ = ["models", "lib", "lanes", "spine", "intake"]
