+"""Location normalization.
+
+Provenance: build_contacts.py (ABBR2FULL, city_key, config_city_keys).
+`city_key` collapses 'McLean'/'Mc Lean' + state -> 'mclean|virginia' and folds the
+Washington D.C. variants so PoP-city comparisons are robust.
+"""
+from __future__ import annotations
+
+import re
+
+ABBR2FULL = {
+    "AL": "Alabama", "AK": "Alaska", "AZ": "Arizona", "AR": "Arkansas",
+    "CA": "California", "CO": "Colorado", "CT": "Connecticut", "DE": "Delaware",
+    "FL": "Florida", "GA": "Georgia", "HI": "Hawaii", "ID": "Idaho",
+    "IL": "Illinois", "IN": "Indiana", "IA": "Iowa", "KS": "Kansas",
+    "KY": "Kentucky", "LA": "Louisiana", "ME": "Maine", "MD": "Maryland",
+    "MA": "Massachusetts", "MI": "Michigan", "MN": "Minnesota",
+    "MS": "Mississippi", "MO": "Missouri", "MT": "Montana", "NE": "Nebraska",
+    "NV": "Nevada", "NH": "New Hampshire", "NJ": "New Jersey",
+    "NM": "New Mexico", "NY": "New York", "NC": "North Carolina",
+    "ND": "North Dakota", "OH": "Ohio", "OK": "Oklahoma", "OR": "Oregon",
+    "PA": "Pennsylvania", "RI": "Rhode Island", "SC": "South Carolina",
+    "SD": "South Dakota", "TN": "Tennessee", "TX": "Texas", "UT": "Utah",
+    "VT": "Vermont", "VA": "Virginia", "WA": "Washington",
+    "WV": "West Virginia", "WI": "Wisconsin", "WY": "Wyoming",
+    "DC": "District of Columbia", "PR": "Puerto Rico",
+}
+FULL2ABBR = {v.lower(): k for k, v in ABBR2FULL.items()}
+
+
+def city_key(city: str, state: str) -> str:
+    """Normalize (city, state) -> 'city|state' comparable key. DC variants folded."""
+    c = re.sub(r"[^a-z]", "", (city or "").lower())
+    c = re.sub(r"(districtofcolumbia|dc)$", "", c)
+    s = (state or "").strip()
+    if len(s) == 2 and s.upper() in ABBR2FULL:
+        s = ABBR2FULL[s.upper()]
+    s = re.sub(r"[^a-z]", "", s.lower())
+    return f"{c}|{s}"
+
+
+def config_city_keys(pop_cities: list[str]) -> set[str]:
+    """Program PoP-city strings ('City, State') -> set of comparable city_keys."""
+    keys = set()
+    for pc in pop_cities or []:
+        parts = [p.strip() for p in pc.split(",")]
+        city = parts[0] if parts else ""
+        state = parts[-1] if len(parts) > 1 else ""
+        keys.add(city_key(city, state))
+    return keys
+
+
+def display_location(city: str, state: str) -> str:
+    """'City, ST' display form (empty string if no city)."""
+    city = (city or "").strip()
+    state = (state or "").strip()
+    if not city and not state:
+        return ""
+    if state and len(state) > 2:
+        state = FULL2ABBR.get(state.lower(), state)
+    return f"{city}, {state}".strip(", ").strip()
diff --git a/clearancejobs_pipeline/models.py b/clearancejobs_pipeline/models.py
