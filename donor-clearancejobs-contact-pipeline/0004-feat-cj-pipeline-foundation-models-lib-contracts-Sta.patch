+"""Company canonicalization for the recruit-from competitor set.
+
+Provenance: build_contacts.py COMPANY_PATS. `canonical_company` maps a free-text
+employer blob (e.g. a ClearanceJobs keyword-thumbnail line like 'INSIGHT GLOBAL, LLC')
+to a canonical company name, or None if no known competitor/prime matched.
+
+These are the BD-relevant companies (Booz Allen prime + its staffing competitor subs).
+For a generic employer not in this set, callers keep the raw string.
+"""
+from __future__ import annotations
+
+import re
+
+COMPANY_PATS = {
+    "Booz Allen Hamilton": re.compile(r"booz\s*allen|@bah\.com|\bbah\b", re.I),
+    "Take2": re.compile(r"take\s*2\b|take2consulting", re.I),
+    "ECS Federal": re.compile(r"\becs federal\b|@ecstech|ecstech\.com", re.I),
+    "Insight Global": re.compile(r"insight\s*global|insightglobal", re.I),
+    "Kforce": re.compile(r"\bkforce\b", re.I),
+    "Beacon Hill": re.compile(r"beacon\s*hill", re.I),
+}
+
+
+def canonical_company(text: str) -> str | None:
+    """First canonical company whose pattern hits `text`, else None."""
+    blob = text or ""
+    for name, pat in COMPANY_PATS.items():
+        if pat.search(blob):
+            return name
+    return None
+
+
+def company_in(text: str, wanted: list[str]) -> str | None:
+    """Return the first company in `wanted` whose pattern hits `text`, else None.
+
+    `wanted` are canonical names (e.g. from _contract_config.json prime + competitor_subs).
+    Falls back to a loose token match for wanted names not in COMPANY_PATS.
+    """
+    blob = text or ""
+    for name in wanted or []:
+        pat = COMPANY_PATS.get(name)
+        if pat and pat.search(blob):
+            return name
+        # loose fallback for companies not in the curated pattern set
+        tok = re.sub(r"[^a-z0-9]+", r"\\s*", name.lower()).strip()
+        if tok and re.search(tok, blob, re.I):
+            return name
+    return None
