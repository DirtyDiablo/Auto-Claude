+"""Shared data contracts.
+
+`RawContact` is the lane-agnostic intermediate every lane (paste/resume) emits.
+`build_contact()` maps a RawContact onto the canonical 50-prop Contact schema
+(see spec 6.4). programs/primes/composite_score/score_breakdown are filled later by
+spine.match_programs; tier is filled here from the title.
+"""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Optional
+
+LANE_PASTE = "paste"
+LANE_RESUME = "resume"
+
+
+def utcnow_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def slug(name: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "-", (name or "").lower()).strip("-")
+
+
+def split_name(full: str) -> tuple[str, str]:
+    parts = [p for p in re.split(r"\s+", (full or "").strip()) if p]
+    if not parts:
+        return "", ""
+    if len(parts) == 1:
+        return parts[0], ""
+    return parts[0], parts[-1]
+
+
+@dataclass
+class RawContact:
+    """Lane-agnostic intermediate. Lanes return List[RawContact]."""
+    lane: str
+    source_file: str
+    cj_id: Optional[str] = None
+    name: str = ""
+    first_name: str = ""
+    last_name: str = ""
+    title: str = ""
+    company: str = ""            # canonical current employer (if matched)
+    company_raw: str = ""        # raw employer string as observed
+    city: str = ""
+    state: str = ""
+    clearance_level: str = ""
+    clearances: list = field(default_factory=list)
+    email: str = ""
+    phone: str = ""
+    linkedin_url: str = ""
+    relo: Optional[bool] = None
+    salary_expectation: str = ""
+    seniority_band: str = ""
+    cj_last_login: str = ""
+    cj_last_login_hot: bool = False
+    keyword_thumbnail: str = ""
+    prior_companies: list = field(default_factory=list)
+    skills: list = field(default_factory=list)
+    program_hint: Optional[str] = None   # PIID the paste/resume was sourced under
+    confidence: str = "C"                # A/B/C
+    needs_review: bool = True
+    extra: dict = field(default_factory=dict)
+
+    def __post_init__(self):
+        if not self.name and (self.first_name or self.last_name):
+            self.name = f"{self.first_name} {self.last_name}".strip()
+        if self.name and not (self.first_name or self.last_name):
+            self.first_name, self.last_name = split_name(self.name)
+
+    def local_key(self) -> str:
+        """Primary dedup key: cj_id when present, else name+location."""
+        from .lib.geo import city_key
+        if self.cj_id:
+            return f"cj:{self.cj_id}"
+        return f"nk:{slug(self.name)}|{city_key(self.city, self.state)}"
+
+
+# canonical 50-prop key order (mirrors entity_contact.txt)
+CONTACT_KEYS = [
+    "id", "bullhorn_candidate_id", "first_name", "last_name", "name", "email", "phone",
+    "mobile", "title", "occupation", "company", "company_name", "status", "address",
+    "city", "state", "zip_code", "location", "clearance_level", "clearances",
+    "linkedin_url", "owner", "tier", "tier_confidence", "programs", "primes",
+    "pain_points", "date_added", "date_modified", "last_activity_date", "note_count",
+    "interaction_history", "outreach_recommendation", "best_channel", "authors",
+    "inferred_locations", "location_confidence", "sources", "source_metadata",
+    "source_provenance", "composite_score", "score_breakdown", "raw_relevance_score",
+    "needs_review", "custom_text1", "custom_text2", "custom_text3", "source_file",
+    "created_at", "updated_at",
+]
+
+
+def build_contact(raw: RawContact, contact_id: Optional[int] = None) -> dict:
+    """Map a RawContact onto the canonical Contact dict (50 schema props + _local_key)."""
+    from .lib.classify import tier_for
+    from .lib.geo import display_location
+
+    first = raw.first_name or split_name(raw.name)[0]
+    last = raw.last_name or split_name(raw.name)[1]
+    now = utcnow_iso()
+    loc = display_location(raw.city, raw.state)
+    src = "ClearanceJobs paste" if raw.lane == LANE_PASTE else "ClearanceJobs resume"
+    clearances = raw.clearances or ([raw.clearance_level] if raw.clearance_level else [])
+    best_channel = "LinkedIn" if raw.linkedin_url else ("Email" if raw.email else "Phone")
+
+    c = {
+        "id": contact_id,
+        "bullhorn_candidate_id": None,
+        "first_name": first,
+        "last_name": last,
+        "name": raw.name or f"{first} {last}".strip(),
+        "email": raw.email or None,
+        "phone": raw.phone or None,
+        "mobile": None,
+        "title": raw.title or None,
+        "occupation": None,
+        "company": raw.company or raw.company_raw or None,
+        "company_name": raw.company or None,
+        "status": "new",
+        "address": None,
+        "city": raw.city or None,
+        "state": raw.state or None,
+        "zip_code": None,
+        "location": loc or None,
+        "clearance_level": raw.clearance_level or None,
+        "clearances": clearances,
+        "linkedin_url": raw.linkedin_url or None,
+        "owner": None,
+        "tier": tier_for(raw.title),
+        "tier_confidence": raw.confidence,
+        "programs": [],
+        "primes": [],
+        "pain_points": list(raw.extra.get("pain_points", [])),
+        "date_added": now,
+        "date_modified": now,
+        "last_activity_date": None,
+        "note_count": 0,
+        "interaction_history": "",
+        "outreach_recommendation": "",
+        "best_channel": best_channel,
+        "authors": [],
+        "inferred_locations": [loc] if loc else [],
+        "location_confidence": "C" if raw.lane == LANE_PASTE else raw.confidence,
+        "sources": [src],
+        "source_metadata": {
+            "cj_id": raw.cj_id,
+            "cj_last_login": raw.cj_last_login,
+            "cj_last_login_hot": raw.cj_last_login_hot,
+            "salary_expectation": raw.salary_expectation,
+            "seniority_band": raw.seniority_band,
+            "relo": raw.relo,
+            "keyword_thumbnail": raw.keyword_thumbnail,
+            "skills": list(raw.skills),
+            "prior_companies": list(raw.prior_companies),
+            "program_hint": raw.program_hint,
+            "lane": raw.lane,
+            **dict(raw.extra.get("source_metadata", {})),
+        },
+        "source_provenance": {src: raw.source_file},
+        "composite_score": None,
+        "score_breakdown": {},
+        "raw_relevance_score": None,
+        "needs_review": raw.needs_review,
+        "custom_text1": None,
+        "custom_text2": None,
+        "custom_text3": None,
+        "source_file": raw.source_file,
+        "created_at": now,
+        "updated_at": now,
+        "_local_key": raw.local_key(),
+    }
+    return c
