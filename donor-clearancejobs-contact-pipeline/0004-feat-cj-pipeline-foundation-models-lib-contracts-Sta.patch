+from clearancejobs_pipeline.models import RawContact, build_contact, CONTACT_KEYS
+
+
+def test_build_contact_has_all_schema_keys():
+    rc = RawContact(lane="paste", source_file="x.txt", name="Jane Doe",
+                    title="Program Manager", city="McLean", state="VA",
+                    clearance_level="TS/SCI", company="Insight Global")
+    c = build_contact(rc)
+    for k in CONTACT_KEYS:
+        assert k in c, f"missing schema key {k}"
+    assert c["tier"] == 3
+    assert c["location"] == "McLean, VA"
+    assert c["first_name"] == "Jane" and c["last_name"] == "Doe"
+    assert c["sources"] == ["ClearanceJobs paste"]
+    assert c["clearances"] == ["TS/SCI"]
+    assert c["location_confidence"] == "C"
+    assert c["_local_key"].startswith("nk:")
+
+
+def test_resume_lane_and_cj_local_key():
+    rc = RawContact(lane="resume", source_file="r.pdf", cj_id="2032428",
+                    name="Jalen Pestillo", confidence="A", needs_review=False)
+    assert rc.local_key() == "cj:2032428"
+    c = build_contact(rc)
+    assert c["sources"] == ["ClearanceJobs resume"]
+    assert c["needs_review"] is False
+    assert c["tier_confidence"] == "A"
+
+
+def test_name_autosplit():
+    rc = RawContact(lane="paste", source_file="x", name="Mary Jane Watson")
+    assert rc.first_name == "Mary" and rc.last_name == "Watson"
